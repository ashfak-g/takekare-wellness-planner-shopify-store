
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">

{% style %}
  .ai-testimonials-section-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    width: 100%;
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    {% if block.settings.container_type == 'default' %}
      max-width: 1280px;
    {% elsif block.settings.container_type == 'custom' %}
      max-width: {{ block.settings.custom_container_width }}px;
    {% endif %}
    margin: 0 auto;
    {% if block.settings.container_type == 'full' %}
      max-width: 100%;
    {% endif %}
  }

  .ai-testimonials-top-content-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-testimonials-subtitle-{{ ai_gen_id }} {
    font-family: 'Caveat', cursive;
    font-weight: 600;
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size_desktop }}px;
    margin: 0 0 12px 0;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: {{ block.settings.heading_size_desktop }}px;
    line-height: 1.3;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: 14px;
    padding: 24px;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-testimonial-quote-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 24px;
    font-size: 60px;
    color: #e30613;
    opacity: 0.15;
    line-height: 1;
    font-family: Georgia, serif;
    pointer-events: none;
    z-index: 0;
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-style: italic;
    color: {{ block.settings.testimonial_text_color }};
    line-height: 1.6;
    margin: 0 0 20px 0;
    padding-top: 8px;
    flex-grow: 1;
    font-size: {{ block.settings.testimonial_text_size_desktop }}px;
    position: relative;
    z-index: 1;
  }

  .ai-testimonial-text-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-testimonial-text-{{ ai_gen_id }} strong,
  .ai-testimonial-text-{{ ai_gen_id }} b {
    color: {{ block.settings.testimonial_highlight_color }};
    font-weight: 600;
    font-style: italic;
  }

  .ai-testimonial-user-info-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    position: relative;
    z-index: 1;
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #e30613;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-style: italic;
    font-size: {{ block.settings.initial_size_desktop }}px;
    flex-shrink: 0;
  }

  .ai-testimonial-user-text-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-name-{{ ai_gen_id }} {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    color: {{ block.settings.name_color }};
    margin: 0 0 2px 0;
    font-size: {{ block.settings.name_size_desktop }}px;
  }

  .ai-testimonial-role-{{ ai_gen_id }} {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: {{ block.settings.role_size_desktop }}px;
    color: {{ block.settings.role_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-testimonials-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_tablet }}px;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_tablet }}px;
    }

    .ai-testimonial-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.testimonial_text_size_tablet }}px;
    }

    .ai-testimonial-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.name_size_tablet }}px;
    }

    .ai-testimonial-role-{{ ai_gen_id }} {
      font-size: {{ block.settings.role_size_tablet }}px;
    }

    .ai-testimonial-avatar-{{ ai_gen_id }} {
      font-size: {{ block.settings.initial_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 16px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-testimonials-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_mobile }}px;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-testimonial-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.testimonial_text_size_mobile }}px;
    }

    .ai-testimonial-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.name_size_mobile }}px;
    }

    .ai-testimonial-role-{{ ai_gen_id }} {
      font-size: {{ block.settings.role_size_mobile }}px;
    }

    .ai-testimonial-avatar-{{ ai_gen_id }} {
      font-size: {{ block.settings.initial_size_mobile }}px;
    }
  }
{% endstyle %}

<testimonials-section-{{ ai_gen_id }} class="ai-testimonials-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    <div class="ai-testimonials-top-content-{{ ai_gen_id }}">
      {% if block.settings.subtitle != blank %}
        <div class="ai-testimonials-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
      {% endif %}
      
      {% if block.settings.heading != blank %}
        <div class="ai-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</div>
      {% endif %}
    </div>

    <div class="ai-testimonials-grid-{{ ai_gen_id }}">
      <div class="ai-testimonial-card-{{ ai_gen_id }}">
        <div class="ai-testimonial-quote-icon-{{ ai_gen_id }}">"</div>
        
        {% if block.settings.testimonial_1_text != blank %}
          <div class="ai-testimonial-text-{{ ai_gen_id }}">
            {{ block.settings.testimonial_1_text }}
          </div>
        {% endif %}

        <div class="ai-testimonial-user-info-{{ ai_gen_id }}">
          <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
            {% if block.settings.testimonial_1_initial != blank %}
              {{ block.settings.testimonial_1_initial | upcase | slice: 0 }}
            {% else %}
              ?
            {% endif %}
          </div>
          <div class="ai-testimonial-user-text-{{ ai_gen_id }}">
            {% if block.settings.testimonial_1_name != blank %}
              <div class="ai-testimonial-name-{{ ai_gen_id }}">{{ block.settings.testimonial_1_name }}</div>
            {% endif %}
            {% if block.settings.testimonial_1_role != blank %}
              <div class="ai-testimonial-role-{{ ai_gen_id }}">{{ block.settings.testimonial_1_role }}</div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="ai-testimonial-card-{{ ai_gen_id }}">
        <div class="ai-testimonial-quote-icon-{{ ai_gen_id }}">"</div>
        
        {% if block.settings.testimonial_2_text != blank %}
          <div class="ai-testimonial-text-{{ ai_gen_id }}">
            {{ block.settings.testimonial_2_text }}
          </div>
        {% endif %}

        <div class="ai-testimonial-user-info-{{ ai_gen_id }}">
          <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
            {% if block.settings.testimonial_2_initial != blank %}
              {{ block.settings.testimonial_2_initial | upcase | slice: 0 }}
            {% else %}
              ?
            {% endif %}
          </div>
          <div class="ai-testimonial-user-text-{{ ai_gen_id }}">
            {% if block.settings.testimonial_2_name != blank %}
              <div class="ai-testimonial-name-{{ ai_gen_id }}">{{ block.settings.testimonial_2_name }}</div>
            {% endif %}
            {% if block.settings.testimonial_2_role != blank %}
              <div class="ai-testimonial-role-{{ ai_gen_id }}">{{ block.settings.testimonial_2_role }}</div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="ai-testimonial-card-{{ ai_gen_id }}">
        <div class="ai-testimonial-quote-icon-{{ ai_gen_id }}">"</div>
        
        {% if block.settings.testimonial_3_text != blank %}
          <div class="ai-testimonial-text-{{ ai_gen_id }}">
            {{ block.settings.testimonial_3_text }}
          </div>
        {% endif %}

        <div class="ai-testimonial-user-info-{{ ai_gen_id }}">
          <div class="ai-testimonial-avatar-{{ ai_gen_id }}">
            {% if block.settings.testimonial_3_initial != blank %}
              {{ block.settings.testimonial_3_initial | upcase | slice: 0 }}
            {% else %}
              ?
            {% endif %}
          </div>
          <div class="ai-testimonial-user-text-{{ ai_gen_id }}">
            {% if block.settings.testimonial_3_name != blank %}
              <div class="ai-testimonial-name-{{ ai_gen_id }}">{{ block.settings.testimonial_3_name }}</div>
            {% endif %}
            {% if block.settings.testimonial_3_role != blank %}
              <div class="ai-testimonial-role-{{ ai_gen_id }}">{{ block.settings.testimonial_3_role }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</testimonials-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('testimonials-section-{{ ai_gen_id }}', TestimonialsSection{{ ai_gen_id }});
  })();
</script>

