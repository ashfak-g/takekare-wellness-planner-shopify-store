
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tabbed-collections-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-tabbed-collections-container-{{ ai_gen_id }} {
    {% if block.settings.container_width == 'page' %}
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    {% else %}
      width: 100%;
      padding: 0 20px;
    {% endif %}
  }

  .ai-tabbed-collections-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-tabbed-collections-heading-{{ ai_gen_id }} {
    font-size: 42px;
    margin: 0 0 12px;
    color: rgb(var(--color-heading-text));
    font-family: var(--font-heading-family);
  }

  .ai-tabbed-collections-subheading-{{ ai_gen_id }} {
    font-size: 16px;
    color: rgb(var(--color-subtext));
    margin: 0;
  }

  .ai-tabbed-collections-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    margin-bottom: 40px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    {% if block.settings.tab_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.tab_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-tabbed-collections-tabs-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-tabbed-collections-tab-{{ ai_gen_id }} {
    padding: 12px 24px;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    white-space: nowrap;
    transition: all 0.3s ease;
    color: {{ block.settings.inactive_tab_color }};
    {% if block.settings.tab_style == 'underline' %}
      border-bottom: 2px solid transparent;
    {% elsif block.settings.tab_style == 'pills' %}
      border-radius: 50px;
    {% elsif block.settings.tab_style == 'buttons' %}
      border-radius: {{ block.settings.button_border_radius }}px;
      border: 1px solid {{ block.settings.inactive_tab_color }};
    {% endif %}
  }

  .ai-tabbed-collections-tab-{{ ai_gen_id }}.active {
    color: {{ block.settings.active_tab_color }};
    {% if block.settings.tab_style == 'underline' %}
      border-bottom-color: {{ block.settings.active_tab_color }};
    {% elsif block.settings.tab_style == 'pills' %}
      background-color: {{ block.settings.active_tab_color }};
      color: #ffffff;
    {% elsif block.settings.tab_style == 'buttons' %}
      background-color: {{ block.settings.active_tab_color }};
      color: #ffffff;
      border-color: {{ block.settings.active_tab_color }};
    {% endif %}
  }

  .ai-tabbed-collections-content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-tabbed-collections-content-{{ ai_gen_id }}.active {
    display: block;
    {% if block.settings.enable_animations %}
      animation: ai-fade-in-{{ ai_gen_id }} 0.4s ease;
    {% endif %}
  }

  {% if block.settings.enable_animations %}
    @keyframes ai-fade-in-{{ ai_gen_id }} {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  {% endif %}

  .ai-tabbed-collections-featured-{{ ai_gen_id }} {
    margin-bottom: 40px;
    {% if block.settings.enable_shadows %}
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    {% endif %}
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background: #fbf8f4;
  }

  .ai-tabbed-collections-featured-inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    aspect-ratio: 16 / 2;
  }

  .ai-tabbed-collections-featured-image-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    {% if block.settings.featured_image_position == 'right' %}
      order: 2;
    {% endif %}
  }

  .ai-tabbed-collections-featured-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    {% if block.settings.featured_image_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.featured_image_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif block.settings.featured_image_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% endif %}
    transition: transform 0.3s ease;
  }

  {% if block.settings.enable_secondary_image %}
    .ai-tabbed-collections-featured-image-{{ ai_gen_id }}:hover img:first-child {
      opacity: 0;
    }

    .ai-tabbed-collections-featured-image-{{ ai_gen_id }} img:last-child {
      position: absolute;
      top: 0;
      left: 0;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .ai-tabbed-collections-featured-image-{{ ai_gen_id }}:hover img:last-child {
      opacity: 1;
    }
  {% endif %}

  .ai-tabbed-collections-featured-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: {{ block.settings.active_tab_color }};
    color: #ffffff;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-tabbed-collections-featured-info-{{ ai_gen_id }} {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-tabbed-collections-featured-title-{{ ai_gen_id }} {
    font-size: 28px;
    margin: 0 0 12px;
    font-weight: 600;
    color: rgb(var(--color-heading-text));
  }

  .ai-tabbed-collections-featured-price-{{ ai_gen_id }} {
    font-size: 24px;
    margin-bottom: 16px;
    font-weight: 600;
    color: #e4032b;
  }

  .ai-tabbed-collections-featured-desc-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: rgb(var(--color-subtext));
    margin-bottom: 24px;
  }

  .ai-tabbed-collections-featured-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_color }};
    text-align: center;
  }

  .ai-tabbed-collections-featured-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    border-color: {{ block.settings.button_hover_color }};
  }

  .ai-tabbed-collections-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .ai-tabbed-collections-card-{{ ai_gen_id }} {
    {% if block.settings.enable_shadows %}
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    {% endif %}
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background: #ffffff;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-tabbed-collections-card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }
  {% endif %}

  .ai-tabbed-collections-card-image-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-tabbed-collections-card-image-{{ ai_gen_id }} img {
    width: 100%;
    display: block;
    {% if block.settings.card_image_ratio == 'square' %}
      aspect-ratio: 1 / 1;
    {% elsif block.settings.card_image_ratio == 'portrait' %}
      aspect-ratio: 3 / 4;
    {% elsif block.settings.card_image_ratio == 'landscape' %}
      aspect-ratio: 4 / 3;
    {% endif %}
    object-fit: cover;
  }

  .ai-tabbed-collections-card-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-tabbed-collections-card-title-{{ ai_gen_id }} {
    font-size: 16px;
    margin: 0 0 8px;
    font-weight: 600;
    color: rgb(var(--color-heading-text));
  }

  .ai-tabbed-collections-card-price-{{ ai_gen_id }} {
    font-size: 18px;
    margin-bottom: 12px;
    font-weight: 600;
    color: rgb(var(--color-text));
  }

  .ai-tabbed-collections-card-desc-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.5;
    color: rgb(var(--color-subtext));
    margin-bottom: 16px;
  }

