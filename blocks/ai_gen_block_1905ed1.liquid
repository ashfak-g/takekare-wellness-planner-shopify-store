<ai-tabbed-collections-{{ ai_gen_id }} class="ai-tabbed-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tabbed-collections-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank or block.settings.section_subheading != blank %}
      <div class="ai-tabbed-collections-header-{{ ai_gen_id }}">
        {% if block.settings.section_heading != blank %}
          <h2 class="ai-tabbed-collections-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
        {% endif %}
        {% if block.settings.section_subheading != blank %}
          <p class="ai-tabbed-collections-subheading-{{ ai_gen_id }}">{{ block.settings.section_subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      assign active_tabs = ''
      for i in (1..6)
        assign tab_label_key = 'tab_' | append: i | append: '_label'
        assign tab_collection_key = 'tab_' | append: i | append: '_collection'
        assign tab_label = block.settings[tab_label_key]
        assign tab_collection = block.settings[tab_collection_key]
        if tab_label != blank and tab_collection != blank
          if active_tabs == ''
            assign active_tabs = i | append: ''
          else
            assign active_tabs = active_tabs | append: ',' | append: i
          endif
        endif
      endfor
      assign tabs_array = active_tabs | split: ','
    %}

    {% if tabs_array.size > 0 %}
      <div class="ai-tabbed-collections-tabs-{{ ai_gen_id }}" role="tablist">
        <div class="button-group">


{% for tab_index in tabs_array %}
          {% assign tab_label_key = 'tab_' | append: tab_index | append: '_label' %}
          {% assign tab_label = block.settings[tab_label_key] %}
          <button
            class="ai-tabbed-collections-tab-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-tab="{{ tab_index }}"
          >
            {{ tab_label }}
          </button>
        {% endfor %}



        </div>
      </div>

      {% for tab_index in tabs_array %}
        {% liquid
          assign tab_collection_key = 'tab_' | append: tab_index | append: '_collection'
          assign tab_max_products_key = 'tab_' | append: tab_index | append: '_max_products'
          assign tab_badge_key = 'tab_' | append: tab_index | append: '_badge_text'
          assign tab_cta_label_key = 'tab_' | append: tab_index | append: '_cta_label'
          assign tab_cta_link_key = 'tab_' | append: tab_index | append: '_cta_link'

          assign collection = block.settings[tab_collection_key]
          assign max_products = block.settings[tab_max_products_key]
          assign badge_text = block.settings[tab_badge_key]
          assign cta_label = block.settings[tab_cta_label_key]
          assign cta_link = block.settings[tab_cta_link_key]
        %}

        <div
          class="ai-tabbed-collections-content-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          role="tabpanel"
          data-content="{{ tab_index }}"
        >
          {% if collection != blank and collection.products.size > 0 %}
            {% assign featured_product = collection.products.first %}
            {% assign remaining_count = max_products | minus: 1 %}

            <div class="ai-tabbed-collections-featured-{{ ai_gen_id }}">
              <div class="ai-tabbed-collections-featured-inner-{{ ai_gen_id }}">
                <div class="ai-tabbed-collections-featured-image-{{ ai_gen_id }}">
                  {% if block.settings.show_featured_badge and badge_text != blank %}
                    <div class="ai-tabbed-collections-featured-badge-{{ ai_gen_id }}">{{ badge_text }}</div>
                  {% endif %}
                  {% if featured_product.featured_image %}
                    <img
                      src="{{ featured_product.featured_image | image_url: width: 800 }}"
                      alt="{{ featured_product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="800"
                      height="800"
                    >
                    {% if block.settings.enable_secondary_image and featured_product.images[1] %}
                      <img
                        src="{{ featured_product.images[1] | image_url: width: 800 }}"
                        alt="{{ featured_product.images[1].alt | escape }}"
                        loading="lazy"
                        width="800"
                        height="800"
                      >
                    {% endif %}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="ai-tabbed-collections-featured-info-{{ ai_gen_id }}">
                  <h3 class="ai-tabbed-collections-featured-title-{{ ai_gen_id }}">{{ featured_product.title }}</h3>
                  <div class="ai-tabbed-collections-featured-price-{{ ai_gen_id }}">{{ featured_product.price | money }}</div>
                  {% if block.settings.show_featured_description and featured_product.description != blank %}
                    {% assign desc_length = block.settings.featured_description_length %}
                    {% assign truncated_desc = featured_product.description | strip_html | truncate: desc_length %}
                    <div class="ai-tabbed-collections-featured-desc-{{ ai_gen_id }}">{{ truncated_desc }}</div>
                  {% endif %}
                  {% if cta_label != blank %}
                    <a
                      href="{% if cta_link != blank %}{{ cta_link }}{% else %}{{ featured_product.url }}{% endif %}"
                      class="ai-tabbed-collections-featured-button-{{ ai_gen_id }}"
                    >
                      {% comment %} {{ cta_label }} {% endcomment %} Discover the Planner
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>

            {% if collection.products.size > 1 %}
              <div class="ai-tabbed-collections-grid-{{ ai_gen_id }}">
                {% for product in collection.products offset: 1 limit: remaining_count %}
                  <div class="ai-tabbed-collections-card-{{ ai_gen_id }}">
                    {% if block.settings.show_card_image %}
                      <div class="ai-tabbed-collections-card-image-{{ ai_gen_id }}">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.featured_image.alt | escape }}"
                            loading="lazy"
                            width="600"
                            height="600"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {% endif %}
                      </div>
                    {% endif %}
                    <div class="ai-tabbed-collections-card-content-{{ ai_gen_id }}">
                      {% if block.settings.show_card_title %}
                        <h4 class="ai-tabbed-collections-card-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                      {% endif %}
                      {% if block.settings.show_card_price %}
                        <div class="ai-tabbed-collections-card-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                      {% endif %}
                      {% if block.settings.show_card_description and product.description != blank %}
                        {% assign card_desc_length = block.settings.card_description_length %}
                        {% assign card_truncated_desc = product.description | strip_html | truncate: card_desc_length %}
                        <div class="ai-tabbed-collections-card-desc-{{ ai_gen_id }}">{{ card_truncated_desc }}</div>
                      {% endif %}
                      {% if block.settings.show_card_button and cta_label != blank %}
                        <a href="{{ product.url }}" class="ai-tabbed-collections-card-button-{{ ai_gen_id }}">
                          {% comment %} {{ cta_label }} {% endcomment %} Discover
                        </a>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          {% else %}
            <div class="ai-tabbed-collections-empty-{{ ai_gen_id }}">
              <p>No products found in this collection. Please select a collection with products.</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <div class="ai-tabbed-collections-empty-{{ ai_gen_id }}">
        <p>Please configure at least one tab with a collection in the block settings.</p>
      </div>
    {% endif %}
  </div>
</ai-tabbed-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class AiTabbedCollections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-tabbed-collections-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-tabbed-collections-content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const tabId = tab.getAttribute('data-tab');
            this.switchTab(tabId);
          });
        });
      }

      switchTab(tabId) {
        this.tabs.forEach((tab) => {
          const isActive = tab.getAttribute('data-tab') === tabId;
          tab.classList.toggle('active', isActive);
          tab.setAttribute('aria-selected', isActive);
        });

        this.contents.forEach((content) => {
          const isActive = content.getAttribute('data-content') === tabId;
          content.classList.toggle('active', isActive);
        });
      }
    }

    customElements.define('ai-tabbed-collections-{{ ai_gen_id }}', AiTabbedCollections{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Tabbed collections",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "text",
      "id": "section_subheading",
      "label": "Subheading",
      "default": "Discover our curated collections"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "page",
          "label": "Page width"
        }
      ],
      "default": "page"
