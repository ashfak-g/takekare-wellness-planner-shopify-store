      {% if block.settings.step_3_number != blank %}
        <div class="anim delay-3 ai-process-card-{{ ai_gen_id }}">
          <div class="ai-process-card-header-{{ ai_gen_id }}">
            <div class="ai-process-number-{{ ai_gen_id }}">{{ block.settings.step_3_number }}</div>
            {% if block.settings.step_3_title != blank %}
              <div class="ai-process-card-title-{{ ai_gen_id }}">
                <h3>{{ block.settings.step_3_title }}</h3>
              </div>
            {% endif %}
          </div>
          {% if block.settings.step_3_subtitle != blank %}
            <div class="ai-process-card-subtitle-{{ ai_gen_id }}">{{ block.settings.step_3_subtitle }}</div>
