      {% endif %}

      {% if block.settings.step_4_number != blank %}
        <div class="anim delay-4 ai-process-card-{{ ai_gen_id }}">
          <div class="ai-process-card-header-{{ ai_gen_id }}">
            <div class="ai-process-number-{{ ai_gen_id }}">{{ block.settings.step_4_number }}</div>
            {% if block.settings.step_4_title != blank %}
