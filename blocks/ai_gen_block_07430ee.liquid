<script>
  (function() {
    'use strict';

    // Pure CSS scroll-triggered animation without external libraries
    function initScrollAnimations(container) {
      if (!container) return;
      
      // Select all elements with .anim class inside this section
      const animatedElements = container.querySelectorAll('.anim');
      if (!animatedElements.length) return;

      // Set up Intersection Observer
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Add 'animated' class to trigger CSS transition
            entry.target.classList.add('animated');
            // Stop observing once animated
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.15,        // Trigger when 15% of element is visible
        rootMargin: '0px 0px -20px 0px'  // Slight offset for better UX
      });

      // Observe each animated element
      animatedElements.forEach(el => observer.observe(el));
    }

    // Initialize for current section
    const sectionElement = document.querySelector('.ai-process-section-{{ ai_gen_id }}');
    if (sectionElement) {
      initScrollAnimations(sectionElement);
    }

    // Shopify dynamic section reload support
    document.addEventListener('shopify:section:load', function(event) {
      const loadedSection = event.target;
      if (loadedSection && loadedSection.classList && loadedSection.classList.contains('ai-process-section-{{ ai_gen_id }}')) {
        initScrollAnimations(loadedSection);
      }
    });

    // Also handle any DOM mutations (for theme builders that add content dynamically)
    if (window.MutationObserver) {
      const bodyObserver = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.type === 'childList' && mutation.addedNodes.length) {
            const sectionStillExists = document.querySelector('.ai-process-section-{{ ai_gen_id }}');
            if (sectionStillExists && !sectionStillExists.hasAttribute('data-animation-initialized')) {
              initScrollAnimations(sectionStillExists);
              sectionStillExists.setAttribute('data-animation-initialized', 'true');
            }
          }
        });
      });
      
      // Only start observing after page load to avoid conflicts
      window.addEventListener('load', function() {
        const targetNode = document.querySelector('.ai-process-section-{{ ai_gen_id }}');
        if (targetNode && !targetNode.hasAttribute('data-animation-initialized')) {
          initScrollAnimations(targetNode);
          targetNode.setAttribute('data-animation-initialized', 'true');
        }
        bodyObserver.observe(document.body, { childList: true, subtree: true });
      });
    }
  })();
</script>

