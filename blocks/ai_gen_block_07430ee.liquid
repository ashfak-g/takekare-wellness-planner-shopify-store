{% comment %} 
  Process Steps Section with Pure CSS Scroll-Triggered Fade-Up Animation
  No external AOS library required. All animations are CSS-driven with Intersection Observer.
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">

{% style %}
/* ===== BASE STYLES ===== */
.ai-process-section-{{ ai_gen_id }} {
  display: block;
  width: 100%;
  background-color: {{ block.settings.section_background_color }};
  padding-top: {{ block.settings.padding_top }}px;
  padding-bottom: {{ block.settings.padding_bottom }}px;
}

.ai-process-container-{{ ai_gen_id }} {
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
  {% if block.settings.container_type == 'default' %}
    max-width: 1280px;
  {% elsif block.settings.container_type == 'full' %}
    max-width: 100%;
  {% elsif block.settings.container_type == 'custom' %}
    max-width: {{ block.settings.custom_container_width }}px;
  {% endif %}
}

.ai-process-header-{{ ai_gen_id }} {
  text-align: center;
  margin-bottom: 60px;
}

.ai-process-subtitle-{{ ai_gen_id }} {
  font-family: 'Caveat', cursive;
  font-weight: 600;
  font-size: {{ block.settings.subtitle_size_desktop }}px;
  color: {{ block.settings.subtitle_color }};
  margin: 0 0 16px 0;
  line-height: 1.3;
}

.ai-process-heading-{{ ai_gen_id }} {
  font-family: 'Instrument Serif', serif;
  font-weight: 400;
  font-size: {{ block.settings.heading_size_desktop }}px;
  line-height: 1.2;
  color: {{ block.settings.heading_color }};
  margin: 0 0 20px 0;
}

.ai-process-heading-{{ ai_gen_id }} h2,
.ai-process-heading-{{ ai_gen_id }} h3,
.ai-process-heading-{{ ai_gen_id }} p {
  margin: 0;
  font-size: inherit;
  line-height: inherit;
  font-weight: inherit;
}

.ai-process-description-{{ ai_gen_id }} {
  font-family: 'DM Sans', sans-serif;
  font-weight: 400;
  font-size: {{ block.settings.description_size_desktop }}px;
  line-height: 1.6;
  color: {{ block.settings.description_color }};
  margin: 0;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}

.ai-process-grid-{{ ai_gen_id }} {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  margin-bottom: 50px;
}

.ai-process-card-{{ ai_gen_id }} {
  background-color: {{ block.settings.card_background }};
  border-radius: 14px;
  padding: 32px 28px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  border: 2px solid transparent;
}

.ai-process-card-{{ ai_gen_id }}:hover {
  transform: translateY(-4px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  border-color: {{ block.settings.card_border_hover_color }};
}

.ai-process-card-header-{{ ai_gen_id }} {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 16px;
}

.ai-process-number-{{ ai_gen_id }} {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: {{ block.settings.number_background }};
  color: {{ block.settings.number_color }};
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Instrument Serif', serif;
  font-weight: 400;
  font-style: italic;
  font-size: {{ block.settings.card_number_size_desktop }}px;
}

.ai-process-card-title-{{ ai_gen_id }} {
  flex: 1;
  margin: 0;
  padding-top: 8px;
}

.ai-process-card-title-{{ ai_gen_id }} h3 {
  font-family: 'DM Sans', sans-serif;
  font-weight: 700;
  font-size: {{ block.settings.card_title_size_desktop }}px;
  line-height: 1.4;
  color: {{ block.settings.card_title_color }};
  margin: 0;
}

.ai-process-card-subtitle-{{ ai_gen_id }} {
  font-family: 'Caveat', cursive;
  font-weight: 600;
  font-size: {{ block.settings.card_subtitle_size_desktop }}px;
  color: {{ block.settings.card_subtitle_color }};
  margin: 0 0 12px 0;
  line-height: 1.3;
}

.ai-process-card-description-{{ ai_gen_id }} {
  font-family: 'DM Sans', sans-serif;
  font-weight: 400;
  font-size: {{ block.settings.card_description_size_desktop }}px;
  line-height: 1.7;
  color: {{ block.settings.card_description_color }};
  margin: 0;
}

.ai-process-cta-{{ ai_gen_id }} {
  text-align: center;
}

.ai-process-button-{{ ai_gen_id }} {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background-color: {{ block.settings.button_background }};
  color: {{ block.settings.button_text_color }};
  font-family: 'DM Sans', sans-serif;
  font-weight: 600;
  font-size: 16px;
  padding: 16px 36px;
  border-radius: 14px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.ai-process-button-{{ ai_gen_id }}:hover {
  background-color: {{ block.settings.button_hover_background }};
  transform: scale(1.05);
}

.ai-process-button-icon-{{ ai_gen_id }} {
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== PURE CSS SCROLL-TRIGGERED FADE-UP ANIMATION ===== */
.ai-process-section-{{ ai_gen_id }} .anim {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
              transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.ai-process-section-{{ ai_gen_id }} .anim.animated {
  opacity: 1;
  transform: translateY(0);
}

/* Delay classes - applied after animation triggers */
.ai-process-section-{{ ai_gen_id }} .delay-1.animated { transition-delay: 0.1s; }
.ai-process-section-{{ ai_gen_id }} .delay-2.animated { transition-delay: 0.2s; }
.ai-process-section-{{ ai_gen_id }} .delay-3.animated { transition-delay: 0.3s; }
.ai-process-section-{{ ai_gen_id }} .delay-4.animated { transition-delay: 0.4s; }
.ai-process-section-{{ ai_gen_id }} .delay-5.animated { transition-delay: 0.5s; }
.ai-process-section-{{ ai_gen_id }} .delay-6.animated { transition-delay: 0.6s; }

/* Responsive Styles */
@media screen and (max-width: 1024px) {
  .ai-process-grid-{{ ai_gen_id }} {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
}

@media screen and (max-width: 768px) {
  .ai-process-section-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top_mobile }}px;
    padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
  }

  .ai-process-container-{{ ai_gen_id }} {
    padding-left: 16px;
    padding-right: 16px;
  }

  .ai-process-header-{{ ai_gen_id }} {
    margin-bottom: 40px;
  }

  .ai-process-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size_mobile }}px;
  }

  .ai-process-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
  }

  .ai-process-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size_mobile }}px;
  }

  .ai-process-grid-{{ ai_gen_id }} {
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }

  .ai-process-card-{{ ai_gen_id }} {
    padding: 24px 20px;
  }

  .ai-process-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_number_size_mobile }}px;
    width: 36px;
    height: 36px;
  }

  .ai-process-card-title-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.card_title_size_mobile }}px;
  }

  .ai-process-card-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_subtitle_size_mobile }}px;
  }

  .ai-process-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size_mobile }}px;
  }

  .ai-process-button-{{ ai_gen_id }} {
    font-size: 15px;
    padding: 14px 30px;
    width: 100%;
  }
}
{% endstyle %}

<process-section-{{ ai_gen_id }} class="ai-process-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
