    <!-- Header with animation class -->
    <div class="ai-process-header-{{ ai_gen_id }} anim delay-1">
      {% if block.settings.subtitle != blank %}
        <div class="ai-process-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
