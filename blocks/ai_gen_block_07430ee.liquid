            <div class="ai-process-card-subtitle-{{ ai_gen_id }}">{{ block.settings.step_1_subtitle }}</div>
          {% endif %}
          {% if block.settings.step_1_description != blank %}
            <p class="ai-process-card-description-{{ ai_gen_id }}">{{ block.settings.step_1_description }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.step_2_number != blank %}
        <div class="anim delay-2 ai-process-card-{{ ai_gen_id }}">
