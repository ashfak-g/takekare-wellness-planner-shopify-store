{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-process-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .ai-process-container-{{ ai_gen_id }} {
    margin: 0 auto;
    {% if block.settings.container_type == 'default' %}
      max-width: 1280px;
    {% elsif block.settings.container_type == 'full' %}
      max-width: 100%;
    {% elsif block.settings.container_type == 'custom' %}
      max-width: {{ block.settings.custom_container_width }}px;
    {% endif %}
  }

  .ai-process-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-process-subtitle-{{ ai_gen_id }} {
    font-family: 'Caveat', cursive;
    font-weight: 600;
    font-size: {{ block.settings.subtitle_size_desktop }}px;
    color: {{ block.settings.subtitle_color_desktop }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-process-heading-{{ ai_gen_id }} {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-style: normal;
    font-size: {{ block.settings.heading_size_desktop }}px;
    line-height: 1.3;
    color: {{ block.settings.heading_color_desktop }};
    margin: 0 0 20px 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-process-heading-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-process-description-{{ ai_gen_id }} {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: {{ block.settings.description_size_desktop }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color_desktop }};
    margin: 0;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-process-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 60px;
  }

  .ai-process-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px 30px;
    position: relative;
    border: 1px solid transparent;
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s, background-color 0.3s;
  }

  .ai-process-card-{{ ai_gen_id }}:hover {
    background: rgb(251, 248, 244);
    border-radius: 12px;
    padding: 36px 28px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transform: translateY(-4px);
    box-shadow: rgba(0, 0, 0, 0.05) 0px 12px 40px;
  }

  .ai-process-card-number-{{ ai_gen_id }} {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-style: italic;
    font-size: {{ block.settings.card_number_size_desktop }}px;
    line-height: 1;
    color: #E4032B;
    opacity: 0.15;
    margin: 0 0 20px 0;
    transition: color 0.3s, opacity 0.3s;
  }

  .ai-process-card-{{ ai_gen_id }}:hover .ai-process-card-number-{{ ai_gen_id }} {
    color: {{ block.settings.card_number_hover_color }};
    opacity: 1;
  }

  .ai-process-card-title-{{ ai_gen_id }} {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    font-size: {{ block.settings.card_title_size_desktop }}px;
    line-height: 1.4;
    color: {{ block.settings.card_title_color_desktop }};
    margin: 0 0 12px 0;
  }

  .ai-process-card-description-{{ ai_gen_id }} {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: {{ block.settings.card_description_size_desktop }}px;
    line-height: 1.6;
    color: {{ block.settings.card_description_color_desktop }};
    margin: 0;
  }

  .ai-process-highlight-{{ ai_gen_id }} {
    background-color: {{ block.settings.highlight_background }};
    border-left: 4px solid {{ block.settings.highlight_border_color }};
    border-radius: {{ block.settings.highlight_border_radius }}px;
    padding: 30px 40px;
  }

  .ai-process-highlight-text-{{ ai_gen_id }} {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-style: italic;
    font-size: {{ block.settings.highlight_size_desktop }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-process-highlight-normal-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_text_color_desktop }};
    display: block;
    margin-bottom: 8px;
  }

  .ai-process-highlight-accent-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_accent_color_desktop }};
    display: block;
  }

  @media screen and (max-width: 1024px) {
    .ai-process-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }
  }

  @media screen and (max-width: 768px) {
    .ai-process-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ block.settings.section_padding_bottom_mobile }}px;
      padding-left: 16px;
      padding-right: 16px;
    }

    .ai-process-header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-process-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_mobile }}px;
      color: {{ block.settings.subtitle_color_mobile }};
    }

    .ai-process-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      color: {{ block.settings.heading_color_mobile }};
    }

    .ai-process-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
      color: {{ block.settings.description_color_mobile }};
    }

    .ai-process-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 40px;
    }

    .ai-process-card-{{ ai_gen_id }} {
      padding: 30px 24px;
    }

    .ai-process-card-{{ ai_gen_id }}:hover {
      padding: 28px 22px;
    }

    .ai-process-card-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_number_size_mobile }}px;
    }

    .ai-process-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_title_size_mobile }}px;
      color: {{ block.settings.card_title_color_mobile }};
    }

    .ai-process-card-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.card_description_size_mobile }}px;
      color: {{ block.settings.card_description_color_mobile }};
    }

    .ai-process-highlight-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .ai-process-highlight-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.highlight_size_mobile }}px;
    }

    .ai-process-highlight-normal-{{ ai_gen_id }} {
      color: {{ block.settings.highlight_text_color_mobile }};
    }

    .ai-process-highlight-accent-{{ ai_gen_id }} {
      color: {{ block.settings.highlight_accent_color_mobile }};
    }
  }
{% endstyle %}

<div class="ai-process-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-process-container-{{ ai_gen_id }}">
    <div class="ai-process-header-{{ ai_gen_id }}">
      {% if block.settings.subtitle != blank %}
        <div class="ai-process-subtitle-{{ ai_gen_id }}">
          {{ block.settings.subtitle }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <div class="ai-process-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </div>
      {% endif %}

      {% if block.settings.description != blank %}
        <p class="ai-process-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="ai-process-cards-{{ ai_gen_id }}">
      {% if block.settings.card_1_number != blank or block.settings.card_1_title != blank %}
        <div class="ai-process-card-{{ ai_gen_id }}">
          {% if block.settings.card_1_number != blank %}
            <div class="ai-process-card-number-{{ ai_gen_id }}">
              {{ block.settings.card_1_number }}
            </div>
          {% endif %}

          {% if block.settings.card_1_title != blank %}
            <h3 class="ai-process-card-title-{{ ai_gen_id }}">
              {{ block.settings.card_1_title }}
            </h3>
          {% endif %}

          {% if block.settings.card_1_description != blank %}
            <p class="ai-process-card-description-{{ ai_gen_id }}">
              {{ block.settings.card_1_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_2_number != blank or block.settings.card_2_title != blank %}
        <div class="ai-process-card-{{ ai_gen_id }}">
          {% if block.settings.card_2_number != blank %}
            <div class="ai-process-card-number-{{ ai_gen_id }}">
              {{ block.settings.card_2_number }}
            </div>
          {% endif %}

          {% if block.settings.card_2_title != blank %}
            <h3 class="ai-process-card-title-{{ ai_gen_id }}">
              {{ block.settings.card_2_title }}
            </h3>
          {% endif %}

          {% if block.settings.card_2_description != blank %}
            <p class="ai-process-card-description-{{ ai_gen_id }}">
              {{ block.settings.card_2_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_3_number != blank or block.settings.card_3_title != blank %}
        <div class="ai-process-card-{{ ai_gen_id }}">
          {% if block.settings.card_3_number != blank %}
            <div class="ai-process-card-number-{{ ai_gen_id }}">
              {{ block.settings.card_3_number }}
            </div>
          {% endif %}

          {% if block.settings.card_3_title != blank %}
            <h3 class="ai-process-card-title-{{ ai_gen_id }}">
              {{ block.settings.card_3_title }}
            </h3>
          {% endif %}

          {% if block.settings.card_3_description != blank %}
            <p class="ai-process-card-description-{{ ai_gen_id }}">
              {{ block.settings.card_3_description }}
            </p>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if block.settings.bottom_text_normal != blank or block.settings.bottom_text_highlight != blank %}
      <div class="ai-process-highlight-{{ ai_gen_id }}">
        <div class="ai-process-highlight-text-{{ ai_gen_id }}">
          {% if block.settings.bottom_text_normal != blank %}
            <span class="ai-process-highlight-normal-{{ ai_gen_id }}">
              {{ block.settings.bottom_text_normal }}
            </span>
          {% endif %}
          {% if block.settings.bottom_text_highlight != blank %}
            <span class="ai-process-highlight-accent-{{ ai_gen_id }}">
              {{ block.settings.bottom_text_highlight }}
            </span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

