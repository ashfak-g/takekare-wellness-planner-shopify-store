{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .faq-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 56px;
  }

  @media (max-width: 768px){
    .faq-header {
    text-align: center;
    margin-bottom: 24px;
  }
  .faq-subtitle{
    font-size: 17px !important;
    margin-bottom: 8px !important;
  }
  .faq-button{
    padding: 16px !important;
  }
  }

  .faq-subtitle {
    font-family: Caveat, cursive;
    color: {{ section.settings.accent_color }};
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .faq-title {
    font-family: Instrument Serif, Georgia, serif;
    font-size: clamp(26px, 3.5vw, 44px);
    font-weight: 400;
    line-height: 1.15;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .faq-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .faq-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    gap: 16px;
  }

  .faq-question {
    font-size: 15px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
    line-height: 1.4;
  }

  .faq-icon {
    color: {{ section.settings.accent_color }};
    font-size: 22px;
    font-weight: 300;
    flex-shrink: 0;
    line-height: 1;
    transition: transform 0.25s;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out, padding 0.3s ease;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.6;
    color: #444;
  }

  /* Interaction simple pour l'ouverture */
  .faq-item.active .faq-answer {
    max-height: 300px; /* Ajuster selon le contenu */
    padding-bottom: 20px;
  }
  
  .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }
{%- endstyle -%}

<section class="section-{{ section.id }}">
  <div class="faq-container">
  <div class="faq-header"
 data-aos="fade-up">
      {% if section.settings.subtitle != blank %}
        <div class="faq-subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
      <h2 class="faq-title">{{ section.settings.title }}</h2>
    </div>

    <div class="faq-list">
      {% for block in section.blocks %}
      <div class="faq-item"
 data-aos="fade-up"
 data-aos-delay="{{ forloop.index0 | times: 40 }}"
 {{ block.shopify_attributes }}>
          <button class="faq-button" onclick="this.parentElement.classList.toggle('active')">
            <span class="faq-question">{{ block.settings.question }}</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retreat FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Contenu Textuel"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Questions fréquentes"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "FAQ"
    },
    {
      "type": "header",
      "content": "Apparence & Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (Rouge/Icones)",
      "default": "#E4032B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#0A0A0A"
    },
    {
      "type": "header",
      "content": "Espacement (Padding)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question / Réponse",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Posez votre question ici"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Écrivez la réponse détaillée ici.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Retreat FAQ",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}