{%- style -%}
  :root {
    --tk-red-{{ section.id }}: {{ section.settings.accent_color }};
    --tk-bg-{{ section.id }}: {{ section.settings.bg_color }};
    --tk-font-display: 'Instrument Serif', Georgia, serif;
    --tk-font-accent: 'Caveat', cursive;
    --tk-font-sans: 'DM Sans', -apple-system, sans-serif;
  }

  .tk-section-{{ section.id }} {
    padding: {{ section.settings.padding_top_mobile }}px 24px {{ section.settings.padding_bottom_mobile }}px 24px;
    background: var(--tk-bg-{{ section.id }});
    font-family: var(--tk-font-sans);
  }

  @media screen and (min-width: 768px) {
    .tk-section-{{ section.id }} {
      padding: {{ section.settings.padding_top_desktop }}px 0 {{ section.settings.padding_bottom_desktop }}px 0;
    }
  }

  .tk-container-{{ section.id }} {
    max-width: 860px;
    margin: 0 auto;
  }

  .tk-header-{{ section.id }} {
    margin-bottom: 40px;
  }

  .tk-subtitle-{{ section.id }} {
    font-family: var(--tk-font-accent);
    color: var(--tk-red-{{ section.id }});
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .tk-title-{{ section.id }} {
    font-family: var(--tk-font-display);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    line-height: 1.2;
    color: #000;
    margin: 0;
  }

  .tk-list-{{ section.id }} {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0 0 48px 0;
  }

  .tk-item-{{ section.id }} {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #ffffff;
    border-radius: 12px;
    padding: 20px 24px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .tk-item-{{ section.id }}:hover {
    border: 1px solid var(--tk-red-{{ section.id }});
    box-shadow: rgba(228, 3, 43, 0.05) 0px 4px 20px;
  }

  .tk-icon-wrapper-{{ section.id }} {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--tk-red-{{ section.id }});
    flex-shrink: 0;
    margin-top: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tk-item-text-{{ section.id }} {
    font-size: 16px;
    color: #0a0a0a;
    line-height: 1.6;
  }

  .tk-item-text-{{ section.id }} p {
    margin: 0;
  }

  .tk-cta-wrapper-{{ section.id }} {
    text-align: center;
  }

  .tk-button-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--tk-red-{{ section.id }});
    color: #ffffff;
    padding: 16px 40px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: all 0.25s ease;
    border: none;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }

  .tk-button-{{ section.id }}:hover {
    background: rgb(200, 2, 31);
    transform: translateY(-2px);
    box-shadow: rgba(228, 3, 43, 0.3) 0px 8px 28px;
  }
{%- endstyle -%}

<section class="tk-section-{{ section.id }}">
  <div class="tk-container-{{ section.id }}">
    
    <div class="tk-header-{{ section.id }}">
      {% if section.settings.subtitle != blank %}
        <div class="tk-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</div>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="tk-title-{{ section.id }}">{{ section.settings.title }}</h2>
      {% endif %}
    </div>

    <ul class="tk-list-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.settings.item_text != blank %}
          <li class="tk-item-{{ section.id }}" {{ block.shopify_attributes }}>
            <div class="tk-icon-wrapper-{{ section.id }}">
              <svg width="10" height="10" fill="none" viewBox="0 0 10 10">
                <path d="M2 5l2.5 2.5L8 3" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
            <div class="tk-item-text-{{ section.id }}">
              {{ block.settings.item_text }}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>

    {% if section.settings.button_label != blank %}
      <div class="tk-cta-wrapper-{{ section.id }}">
        {%- comment -%} 
          Ekhane amra standard cart form logic use korchi jate current page-er product add hoy.
          Jodi section settings theke product select kora thake tobe seta add hobe,
          na hoy current page (product page) er product-ti add hobe.
        {%- endcomment -%}

        {%- assign product_to_use = section.settings.product_to_add | default: product -%}
        {%- assign variant_id = product_to_use.first_available_variant.id -%}

        {% if variant_id %}
          <button type="button" 
                  onclick="addToCartAndRedirect{{ section.id | replace: '-', '_' }}({{ variant_id }})" 
                  class="tk-button-{{ section.id }}">
            {{ section.settings.button_label }}
            <svg width="16" height="16" fill="none" viewBox="0 0 16 16">
              <path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>

          <script>
            function addToCartAndRedirect{{ section.id | replace: '-', '_' }}(variantId) {
              let formData = {
                'items': [{
                  'id': variantId,
                  'quantity': 1
                }]
              };

              fetch(window.Shopify.routes.root + 'cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
              })
              .then(response => {
                window.location.href = '/cart';
              })
              .catch((error) => {
                console.error('Error:', error);
                window.location.href = '/cart';
              });
            }
          </script>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Digital Product Benefit",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fbf8f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Red)",
      "default": "#e4032b"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "C'est pour toi si…"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Ce produit est fait pour toi"
    },
    {
      "type": "header",
      "content": "Cart & Button Action"
    },
    {
      "type": "product",
      "id": "product_to_add",
      "label": "Select Product to Add",
      "info": "Jodi ekhane product select na koren, tobe je product page e section ta ache oi product ta cart e add hobe."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Accéder maintenant — 49€"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "richtext",
          "id": "item_text",
          "label": "Benefit Text",
          "default": "<p>Your benefit text here</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Digital Product Benefit",
      "blocks": [
        { "type": "benefit", "settings": { "item_text": "<p>Tu utilises déjà Notion mais ton espace est chaotique ou vide</p>" } },
        { "type": "benefit", "settings": { "item_text": "<p>Tu veux un système prêt à l'emploi sans passer des heures à le construire</p>" } },
        { "type": "benefit", "settings": { "item_text": "<p>Tu veux appliquer la Méthode Structurée directement en digital</p>" } }
      ]
    }
  ]
}
{% endschema %}