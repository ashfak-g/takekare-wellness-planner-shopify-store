{%- style -%}
  .expert-section-{{ section.id }} {
    padding: {{ section.settings.padding_vertical }}px 0;
    background: {{ section.settings.bg_color }};
    overflow: hidden;
  }
  .expert-container-{{ section.id }} {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .expert-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
    min-height: 520px;
  }
  .expert-image-wrapper {
    position: relative;
    overflow: hidden;
    min-height: 420px;
    order: {{ section.settings.image_order }};
  }
  .expert-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .expert-quote-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 18px 22px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .expert-content-side {
    background: {{ section.settings.content_bg }};
    padding: clamp(40px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .expert-label-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .expert-label-line {
    width: 24px;
    height: 1px;
    background: {{ section.settings.accent_color }};
  }
  .expert-label-text {
    color: {{ section.settings.accent_color }};
    font-family: Caveat, cursive;
    font-size: 17px;
    font-weight: 600;
  }
  .expert-content-side h2 {
    font-family: Instrument Serif, Georgia, serif;
    font-size: clamp(30px, 3.5vw, 44px);
    line-height: 1.15;
    margin-bottom: 20px;
    font-weight: 400;
  }
  .expert-content-side h2 em {
    font-family: Instrument Serif, Georgia, serif;
    color: {{ section.settings.accent_color }};
    font-style: italic;
  }
  .expert-description {
    font-size: 15px;
    line-height: 1.75;
    color: #5c564f;
    margin-bottom: 32px;
  }
  .badge-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .custom-badge {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
    color: #5c564f;
  }
  .expert-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: {{ section.settings.accent_color }};
    color: #fff;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: 0.25s;
  }

  .expert-btn:hover {
    transform: translateY(-2px);
    box-shadow: rgba(228, 3, 43, 0.3) 0px 8px 24px;
  }

  @media (max-width: 768px) {
    .expert-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
    .expert-image-wrapper {
        order: 0 !important;
    }
    .expert-quote-card {
      display: none;
  }
  .expert-label-text {
    font-size: 14px;
  }
  .expert-content-side h2 {
    font-size: 26px;
  }
  .expert-description {
    font-size: 13px;
  }
  }
{%- endstyle -%}

<section class="expert-section-{{ section.id }}">
  <div class="expert-container-{{ section.id }}">
    <div class="expert-grid-{{ section.id }}"
     data-aos="fade-up"
     data-aos-duration="900"
     data-aos-easing="ease-out-cubic">
      
      <div class="expert-image-wrapper"
     data-aos="fade-right"
     data-aos-delay="100">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt }}">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
        
        <div class="expert-quote-card"
     data-aos="fade-up"
     data-aos-delay="200">
          <p style="font-family: Caveat, cursive; font-size: 16px; color: #fff; font-weight: 600; margin:0;">"{{ section.settings.quote_text }}"</p>
          <p style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 8px; margin-bottom: 0;">— {{ section.settings.quote_author }}</p>
        </div>
      </div>

      <div class="expert-content-side"
     data-aos="fade-left"
     data-aos-delay="150">
        <div class="expert-label-wrapper" data-aos="fade-up" data-aos-delay="200">
          <div class="expert-label-line"></div>
          <span class="expert-label-text">{{ section.settings.label }}</span>
        </div>

        <h2 data-aos="fade-up" data-aos-delay="250">{{ section.settings.heading }}</h2>

        <div class="expert-description" data-aos="fade-up" data-aos-delay="300">
          {{ section.settings.description }}
        </div>

        <div class="badge-container" data-aos="fade-up" data-aos-delay="350">
          {% for block in section.blocks %}
            <span class="custom-badge">{{ block.settings.badge_text }}</span>
          {% endfor %}
        </div>

        {% if section.settings.button_label != blank %}
          <div>
           <a href="{{ section.settings.button_link }}" class="expert-btn"
   data-aos="fade-up"
   data-aos-delay="400">
              {{ section.settings.button_label }}
              <svg width="16" height="16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Expert Profile Grid",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Expert Image"
    },
    {
      "type": "select",
      "id": "image_order",
      "label": "Image Position (Desktop)",
      "options": [
        { "value": "0", "label": "Left" },
        { "value": "1", "label": "Right" }
      ],
      "default": "1"
    },
    {
      "type": "text",
      "id": "quote_text",
      "label": "Quote",
      "default": "Je ne délègue pas les accompagnements. Chaque projet, c'est moi."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Author",
      "default": "Léa Coffrant"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Top Label",
      "default": "Avec qui tu travailles"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (HTML allowed: <br>, <em>)",
      "default": "Léa Coffrant, <br><em>Notion addict</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Chaque accompagnement est réalisé directement...</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Voir les offres"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
        "type": "header",
        "content": "Styling"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e4032b"
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Content Background",
      "default": "#fbf8f4"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top/Bottom Padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Expert"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Expert Profile Grid",
      "blocks": [
        { "type": "badge" },
        { "type": "badge" }
      ]
    }
  ]
}
{% endschema %}