{%- style -%}
  .cta-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg }};
  }
  .cta-container-{{ section.id }} {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .cta-box-{{ section.id }} {
    background: {{ section.settings.box_bg }};
    border-radius: 12px;
    padding: 48px 40px;
    text-align: center;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }
  .cta-subheading-{{ section.id }} {
    color: {{ section.settings.accent_color }};
    font-family: Caveat, cursive;
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .cta-box-{{ section.id }} h2 {
    font-family: Instrument Serif, Georgia, serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 12px;
    color: #0a0a0a;
  }
  .cta-description-{{ section.id }} {
    font-size: 16px;
    color: #5c564f;
    max-width: 480px;
    margin: 0 auto 28px;
    line-height: 1.7;
  }
  .cta-button-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: {{ section.settings.accent_color }};
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    transition: 0.25s;
    text-decoration: none;
    width: auto;
  }

  
  .cta-button-{{ section.id }}:hover {
    transform: translateY(-2px);
    box-shadow: rgba(228, 3, 43, 0.3) 0px 8px 28px;
  }
{%- endstyle -%}

<section class="cta-section-{{ section.id }}">
  <div class="cta-container-{{ section.id }}">
    <div class="cta-box-{{ section.id }}" data-aos="fade-up">
      
      {% if section.settings.sub_title != blank %}
        <div class="cta-subheading-{{ section.id }}" data-aos="fade-up">
          {{ section.settings.sub_title }}
        </div>
      {% endif %}

      <h2 data-aos="fade-up">{{ section.settings.title }}</h2>

      {% if section.settings.desc != blank %}
        <p class="cta-description-{{ section.id }}" data-aos="fade-up">
          {{ section.settings.desc }}
        </p>
      {% endif %}

      {% if section.settings.btn_label != blank %}
        <a href="{{ section.settings.btn_url }}" class="cta-button-{{ section.id }}" data-aos="fade-up">
          {{ section.settings.btn_label }}
          <svg width="16" height="16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact CTA Box",
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub-heading",
      "default": "Une question ?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Parlons de ton projet"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "Tu as un projet particulier ou une demande spécifique ? N'hésite pas à me contacter directement."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Me contacter"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Design & Spacing"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background Color",
      "default": "#fbf8f4"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Inner Box Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Red)",
      "default": "#e4032b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Contact CTA Box"
    }
  ]
}
{% endschema %}