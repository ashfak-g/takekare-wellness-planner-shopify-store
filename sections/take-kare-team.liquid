{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  .team-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media screen and (max-width: 768px) {
    .team-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
    .section-{{ section.id }} {
      padding-top: 36px;
      padding-bottom: 32px;
    }
    .sec-header{
      margin-bottom: 28px !important;
    }
    .sub-heading{
      font-size: 18px !important;
      margin-bottom: 10px !important;
    }
    .heading{
      font-size: 26px !important;
    }
  }

  .card-img-wrapper {
    height: 320px;
    overflow: hidden;
  }
  .card-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.5s;
    transform: scale(1);
}

.card-img-wrapper img:hover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.5s;
    transform: scale(1.04);
}

  .mystery-card {
    height: 320px;
    background: #e8e3dc;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{%- endstyle -%}

<section class="section-{{ section.id }}">
 <div class="sec-header"
 data-aos="fade-up" style="text-align: center; margin-bottom: 60px; padding: 0 24px;">
    <div class="sub-heading" style="font-family: Caveat, cursive; color: {{ section.settings.accent_color }}; font-size: 22px; font-weight: 600; margin-bottom: 16px;">
      {{ section.settings.sub_heading }}
    </div>
    <h2 class="heading" style="font-family: Instrument Serif, Georgia, serif; font-size: clamp(28px, 3.5vw, 48px); font-weight: 400; line-height: 1.15; color: #0a0a0a; margin: 0;">
      {{ section.settings.heading }}
    </h2>
  </div>

  <div class="team-grid-{{ section.id }}">
    {%- for block in section.blocks -%}
      <div style="border-radius: 16px; overflow: hidden; background: #fbf8f4;"
 data-aos="fade-up" {{ block.shopify_attributes }}>
        
        {% if block.type == 'member' %}
          <div class="card-img-wrapper">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        {% else %}
          <div class="mystery-card">
            <div style="text-align: center;">
              <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(228, 3, 43, 0.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                <span style="font-family: Instrument Serif, Georgia, serif;font-size: 32px; color: {{ section.settings.accent_color }}; font-style: italic;">?</span>
              </div>
              <div style="font-family: Caveat, cursive; color: {{ section.settings.accent_color }}; font-size: 16px; font-weight: 600;">
                {{ block.settings.mystery_label }}
              </div>
            </div>
          </div>
        {% endif %}

        <div style="padding: 28px 28px 32px;">
          <div style="font-family: Caveat, cursive; color: {{ section.settings.accent_color }}; font-size: 14px; margin-bottom: 8px; font-weight: 600;">
            {{ block.settings.role }}
          </div>
          <h3 style="Instrument Serif, Georgia, serif; font-size: 26px; font-weight: 400; color: #0a0a0a; margin: 0 0 12px 0;">
            {{ block.settings.name }}
          </h3>
          <p style="font-family: DM Sans, -apple-system, sans-serif; font-size: 14px; line-height: 1.75; color: #5c564f; margin: 0;">
            {{ block.settings.bio }}
          </p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Take Kare Team",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub-heading",
      "default": "Tes intervenantes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Qui t'accompagne"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e4032b"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "role", "label": "Role", "default": "Fondatrice" },
        { "type": "text", "id": "name", "label": "Name", "default": "Léa Coffrant" },
        { "type": "textarea", "id": "bio", "label": "Bio", "default": "Bio goes here..." }
      ]
    },
    {
      "type": "mystery",
      "name": "Mystery Guest",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "mystery_label", "label": "Placeholder Text", "default": "Invitée surprise" },
        { "type": "text", "id": "role", "label": "Role", "default": "Intervenante invitée" },
        { "type": "text", "id": "name", "label": "Name", "default": "À annoncer" },
        { "type": "textarea", "id": "bio", "label": "Bio", "default": "Description of the guest role..." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Take Kare Team",
      "blocks": [
        { "type": "member" },
        { "type": "mystery" }
      ]
    }
  ]
}
{% endschema %}