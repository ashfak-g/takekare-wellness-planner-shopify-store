{%- style -%}
.anim-slide-up {
  opacity: 0;
  animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    min-height: {{ section.settings.min_height }}vh;
    display: flex;
    flex-direction: row;
    background: {{ section.settings.bg_color }};
    overflow: hidden;
    position: relative;
  }

  .hero-image-wrapper-{{ section.id }} {
    flex: 0 0 50%;
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 1023px) {
    .hero-image-wrapper-{{ section.id }} {
      aspect-ratio: 16 / 9;
    }
    .section-{{ section.id }} {
      flex-direction: column;
    }
  }

  .hero-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    display: block;
  }

  .hero-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    /*background: linear-gradient(to right, transparent 60%, {{ section.settings.bg_color }} 100%);*/
  }

  .hero-content-wrapper-{{ section.id }} {
    flex: 1 1 0%;
    display: flex;
    align-items: center;
    padding: clamp(48px, 6vw, 80px) clamp(40px, 5vw, 80px);
  }
  @media (max-width: 768px){
    .hero-content-wrapper-{{ section.id }} {
    flex: 1 1 0%;
    display: flex;
    align-items: center;
    padding: 24px 20px 36px;
  }
  .hero-tags-{{ section.id }}{
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 16px !important;
  }
  .hero-subtitle{
    font-size: 15px !important;
  }
  .hero-title{
    font-size: 30px !important;
    margin-bottom: 14px !important;
  }
  .hero-desc{
    font-size: 13px !important;
    margin-bottom: 24px !important;
  }
  .price-main{
    font-size: 36px !important;
  }
  .price-row{
    margin-bottom: 12px !important;
  }
}

  .hero-content-{{ section.id }} {
    max-width: 520px;
    width: 100%;
  }

  .hero-tags-{{ section.id }} {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .hero-tag-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    color: #5C564F;
  }

  .hero-subtitle-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .hero-line {
    width: 28px;
    height: 1px;
    background: {{ section.settings.accent_color }};
  }

  .hero-subtitle {
    font-family: var(--font-accent-val, sans-serif);
    color: {{ section.settings.accent_color }};
    font-size: 18px;
    font-family: Caveat, cursive;
    font-weight: 600;
  }

  .hero-title {
    font-family: Instrument Serif, Georgia, serif;
    font-size: clamp(36px, 4.5vw, 60px);
    font-weight: 400;
    line-height: 1.1;
    color: #0A0A0A;
    margin-bottom: 24px;
  }

  .hero-title em {
    font-style: italic;
    color: {{ section.settings.accent_color }};
  }

  .hero-desc {
    font-size: 15px;
    font-family: DM Sans, -apple-system, sans-serif;
    line-height: 1.8;
    color: #5C564F;
    margin-bottom: 32px;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .price-main {
    font-family: Instrument Serif, Georgia, serif;
    font-size: 44px;
    font-weight: 400;
    color: {{ section.settings.accent_color }};
    line-height: 1;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgb(228, 3, 43);
    color: #ffffff;
    padding: 15px 32px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: 0.25s;
    width: auto;
  }

  .btn-primary:hover{
    transform: translateY(-2px);
    box-shadow: rgba(228, 3, 43, 0.3) 0px 8px 24px;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 2px solid rgba(0, 0, 0, 0.12);
    color: #0A0A0A;
    padding: 15px 24px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    background: transparent;
    width: auto;
  }

  .btn-secondary:hover {
    border: 2px solid rgb(228, 3, 43);
    color: rgb(228, 3, 43);
  }

{%- endstyle -%}

<section class="section-{{ section.id }}">
<div class="hero-image-wrapper-{{ section.id }}"
 data-aos="fade-right">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" 
           alt="{{ section.settings.image.alt }}" 
           class="hero-img-{{ section.id }}"
           loading="lazy">
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-img-' | append: section.id }}
    {% endif %}
    <div class="hero-overlay-{{ section.id }}"></div>
  </div>

  <div class="hero-content-wrapper-{{ section.id }}">
<div class="hero-content-{{ section.id }}">
      
      <div class="hero-tags-{{ section.id }} anim-slide-up delay-1">
        {% for block in section.blocks %}
          {% if block.type == 'tag' %}
            <div class="hero-tag-item">
              <span>{{ block.settings.icon }}</span>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="hero-subtitle-wrapper anim-slide-up delay-2">
        <div class="hero-line"></div>
        <span class="hero-subtitle">{{ section.settings.subtitle }}</span>
      </div>

      
      <h1 class="hero-title anim-slide-up delay-3">{{ section.settings.title }}</h1>

      <div class="hero-desc anim-slide-up delay-4">{{ section.settings.description }}</div>

      <div style="margin-bottom: 20px;" class="anim-slide-up delay-4">
        <div class="price-row">
          <span class="price-main">{{ section.settings.price }}</span>
          <span style="font-size: 13px; color: #8A8178;">{{ section.settings.price_info }}</span>
        </div>
        
        <div style="display: flex; gap: 10px; flex-flow: wrap;">
          {% if section.settings.btn_1_text != blank %}
            <a href="{{ section.settings.btn_1_link }}" class="btn-primary">
              {{ section.settings.btn_1_text }}
              <svg width="16" height="16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          {% endif %}
          
          {% if section.settings.btn_2_text != blank %}
            <a href="{{ section.settings.btn_2_link }}" class="btn-secondary">
              {{ section.settings.btn_2_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <p style="font-size: 12px; color: #8A8178;" class="anim-slide-up delay-4">{{ section.settings.footer_text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Retreat Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center top"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FBF8F4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Red)",
      "default": "#E4032B"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "La Retraite Structurée"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title (Supports <br> and <em>)",
      "default": "3 jours pour tout <br><em>remettre en ordre.</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Une retraite d'organisation intensive — en petit groupe, dans un lieu de caractère."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "1 490€"
    },
    {
      "type": "text",
      "id": "price_info",
      "label": "Price Info",
      "default": "tout inclus (hébergement + repas + ateliers)"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Button 1 Label",
      "default": "Réserver ma place"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Button 2 Label",
      "default": "Voir le programme"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Button 2 Link"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "✓ Paiement en plusieurs fois possible"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum Section Height",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Badge / Tag",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "📍"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Tag Text",
          "default": "Lieu confidentiel, France"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Retreat Split",
      "blocks": [
        { "type": "tag", "settings": { "icon": "📍", "text": "Lieu confidentiel, France" } },
        { "type": "tag", "settings": { "icon": "📅", "text": "Automne 2025" } },
        { "type": "tag", "settings": { "icon": "👥", "text": "12 places max" } }
      ]
    }
  ]
}
{% endschema %}