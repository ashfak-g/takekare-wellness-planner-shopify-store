{%- style -%}
  .footer-{{ section.id }} {
    background: {{ section.settings.footer_bg }};
    border-top: 1px solid rgba(10, 10, 10, 0.08);
    color: rgba(10, 10, 10, 0.4);
    font-family: inherit;
  }

  .footer-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 40px 24px 24px;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }

  .footer-logo img {
    height: 30px;
    width: auto;
    display: block;
  }

  .footer-nav {
    display: flex;
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .footer-nav a {
    color: rgba(10, 10, 10, 0.4);
    font-size: 13px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: #E4032B;
  }

  .footer-socials {
    display: flex;
    gap: 12px;
  }

  .social-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(10, 10, 10, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(10, 10, 10, 0.4);
    transition: 0.2s;
    text-decoration: none;
  }

  .social-icon:hover {
    border-color: #E4032B;
    color: #E4032B;
    transform: translateY(-2px);
  }

  .footer-bottom {
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid rgba(10, 10, 10, 0.08);
    text-align: center;
    color: rgba(10, 10, 10, 0.3);
    font-size: 12px;
  }
{%- endstyle -%}

<footer class="footer-{{ section.id }}">
  <div class="footer-container">
    <div class="footer-top">
      
      <div class="footer-logo">
        <a href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 200 | image_tag: alt: shop.name }}
          {%- else -%}
            <span style="font-weight: bold; color: #0A0A0A;">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <ul class="footer-nav">
        {%- for link in section.settings.footer_menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>

      <div class="footer-socials">
        {%- if section.settings.insta_link != blank -%}
          <a href="{{ section.settings.insta_link }}" class="social-icon" target="_blank" aria-label="Instagram">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"></rect><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
          </a>
        {%- endif -%}

        {%- if section.settings.linkedin_link != blank -%}
          <a href="{{ section.settings.linkedin_link }}" class="social-icon" target="_blank" aria-label="LinkedIn">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-4 0v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="footer-bottom">
      {{ section.settings.copyright_text }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "color",
      "id": "footer_bg",
      "label": "Background Color",
      "default": "#FBF8F4"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer Menu",
      "default": "footer"
    },
    {
      "type": "url",
      "id": "insta_link",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "linkedin_link",
      "label": "LinkedIn URL"
    },
    {
      "type": "inline_richtext",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 Take Kare — Tous droits réservés"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer"
    }
  ]
}
{% endschema %}