{%- style -%}
  :root {
    --font-accent-val: 'Caveat', cursive;
    --font-display-val: 'Instrument Serif', Georgia, serif;
    --font-sans-val: 'DM Sans', -apple-system, sans-serif;
    --color-primary-red: #e4052b;
    --color-text-muted: #6b6560;
  }

  .target-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    font-family: var(--font-sans-val);
    -webkit-font-smoothing: antialiased;
  }

  .target-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .target-header {
    text-align: center;
    margin-bottom: 52px;
  }

  .target-subheading {
    font-family: var(--font-accent-val);
    color: var(--color-primary-red);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .target-title {
    font-family: var(--font-display-val);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 400;
    color: #0a0a0a;
    line-height: 1.15;
    margin: 0;
  }

  .target-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 768px) {
    .target-grid {
      grid-template-columns: 1fr;
    }
  }

  .target-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 32px 28px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }

  .target-card:hover {
    border: 1px solid rgba(228, 3, 43, 0.15);
    transition: 0.25s;
    transform: translateY(-3px);
    box-shadow: rgba(228, 3, 43, 0.06) 0px 8px 32px;
  }

  .target-card-title {
    font-family: var(--font-display-val);
    font-size: 20px;
    font-weight: 400;
    color: var(--color-primary-red);
    margin-bottom: 10px;
    line-height: 1.25;
    margin-top: 0;
  }

  .target-card-text {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }
{%- endstyle -%}

<section class="target-section-{{ section.id }}">
  <div class="target-container">
    
    <div class="target-header">
      {% if section.settings.subheading != blank %}
        <div class="target-subheading">{{ section.settings.subheading }}</div>
      {% endif %}
      
      <h2 class="target-title">
        {{ section.settings.title }}
      </h2>
    </div>

    <div class="target-grid">
      {% for block in section.blocks %}
        <div class="target-card" {{ block.shopify_attributes }}>
          <h3 class="target-card-title">{{ block.settings.title }}</h3>
          <p class="target-card-text">{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Planner Target Audience",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pour qui ?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Ce planner est fait pour toi si…"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fbf8f4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "audience_card",
      "name": "Audience Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Tu te noies dans les tâches"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Card Description",
          "default": "Tu as l'impression de travailler tout le temps sans avancer vraiment."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Planner Target Audience",
      "blocks": [
        { "type": "audience_card" },
        { "type": "audience_card" },
        { "type": "audience_card" }
      ]
    }
  ]
}
{% endschema %}