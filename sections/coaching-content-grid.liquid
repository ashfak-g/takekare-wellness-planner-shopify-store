{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .coaching-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .coaching-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .coaching-accent {
    font-family: Caveat, cursive; /* Adjust if you have a specific accent font variable */
    color: {{ section.settings.accent_color }};
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .coaching-title {
  font-family: Instrument Serif, Georgia, serif;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 16px;
    color: #000;
  }

  .coaching-description {
    font-size: 16px;
    color: rgb(138, 129, 120);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .coaching-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 20px;
  }

  @media screen and (min-width: 480px) {
    .coaching-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (min-width: 990px) {
    .coaching-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .coaching-card {
    background: rgb(251, 248, 244);
    border-radius: 12px;
    padding: 28px 24px;
    text-align: center;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease;
  }

  @media (max-width: 768px){
    .coaching-card{
    background: rgb(251, 248, 244);
    border-radius: 12px;
    padding: 18px 14px;
    text-align: center;
    border: 1px solid rgba(0, 0, 0, 0.06);
    }

    .coaching-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .coaching-header {
    text-align: center;
    margin-bottom: 20px;
  }
  .coaching-accent{
    font-size: 17px;
  }

  }

  .card-icon {
    font-size: 28px;
    color: {{ section.settings.accent_color }};
    margin-bottom: 12px;
  }

  .card-heading {
    font-weight: 700;
    font-size: 15px;
    margin-bottom: 4px;
    color: rgb(10, 10, 10);
  }

  .card-subtext {
    font-size: 13px;
    color: rgb(138, 129, 120);
  }
{%- endstyle -%}

<section class="section-{{ section.id }}">
  <div class="coaching-container">
    <div class="coaching-header" data-aos="fade-up">
      {% if section.settings.accent_text != blank %}
        <div class="coaching-accent">{{ section.settings.accent_text }}</div>
      {% endif %}
      
      {% if section.settings.title != blank %}
        <h2 class="coaching-title">{{ section.settings.title }}</h2>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <p class="coaching-description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

   <div class="coaching-grid" data-aos="fade-up">
      {%- for block in section.blocks -%}
        <div class="coaching-card" 
     data-aos="fade-up"
     {{ block.shopify_attributes }}>
          <div class="card-icon">{{ block.settings.icon }}</div>
          <div class="card-heading">{{ block.settings.heading }}</div>
          <div class="card-subtext">{{ block.settings.subtext }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coaching Content Grid",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Icons/Label)",
      "default": "#e4032b"
    },
    {
      "type": "text",
      "id": "accent_text",
      "label": "Accent Label",
      "default": "The content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "What you receive"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Through videos, practical exercises and a workbook, you build your personalized organizational system."
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 140
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top Mobile",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom Mobile",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Feature Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Text/Emoji/Symbol)",
          "default": "▷"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "6 Video Modules"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "One per pillar of the Method"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coaching Content Grid",
      "blocks": [
        { "type": "item", "settings": { "icon": "▷", "heading": "6 Video Modules", "subtext": "One per pillar" } },
        { "type": "item", "settings": { "icon": "◻", "heading": "Workbook", "subtext": "Exercises and templates" } },
        { "type": "item", "settings": { "icon": "∞", "heading": "Lifetime access", "subtext": "Come back whenever" } },
        { "type": "item", "settings": { "icon": "↺", "heading": "Updates", "subtext": "Program evolves with you" } }
      ]
    }
  ]
}
{% endschema %}