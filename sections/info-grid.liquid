{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }
  
  .info-grid-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .info-grid-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .info-grid-subtitle {
    font-family: Caveat, cursive;
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 16px;
    color: {{ section.settings.accent_color }};
  }

  .info-grid-title {
    font-family: Instrument Serif, Georgia, serif;
    font-size: clamp(28px, 3.5vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    color: #0a0a0a;
    margin: 0;
  }

  .info-grid-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .info-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 24px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: 0.3s;
  }

  .info-card:hover {
    background: rgb(255, 255, 255);
    border-radius: 12px;
    padding: 24px;
    border: 1px solid rgba(228, 3, 43, 0.2);
    transition: 0.3s;
    transform: translateY(-2px);
  }

  .info-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  .info-card-icon {
    font-size: 28px;
    margin-bottom: 12px;
  }

  .info-card-title {
    font-weight: 700;
    font-size: 15px;
    color: #0a0a0a;
    margin-bottom: 8px;
  }

  .info-card-text {
    font-size: 13px;
    color: #5c564f;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 1024px) {
    .info-grid-wrapper { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 768px) {
    .info-grid-wrapper { grid-template-columns: 1fr; }
    .section-{{ section.id }} {
      padding-top: 60px;
      padding-bottom: 60px;
    }

    .info-grid-header {
    text-align: center;
    margin-bottom: 24px;
  }
  .section-{{ section.id }} {
    padding-top: 36px;
    padding-bottom: 36px;
  }
  .info-grid-title {
    font-size: 26px;
  }
  .info-grid-subtitle {
    font-size: 18px;
    margin: 0;
    padding-bottom: 12px;
  }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}">
  <div class="info-grid-container">
    
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="info-grid-header"
 data-aos="fade-up">
        <div class="info-grid-subtitle">{{ section.settings.subtitle }}</div>
        <h2 class="info-grid-title">{{ section.settings.title }}</h2>
      </div>
    {% endif %}

    <div class="info-grid-wrapper">
      {% for block in section.blocks %}
        <div class="info-card"
 data-aos="fade-up"
 data-aos-delay="{{ forloop.index0 | times: 40 }}"
 {{ block.shopify_attributes }}>
         <div class="info-card-icon">{{ block.settings.icon }}</div>
          <div class="info-card-title">{{ block.settings.heading }}</div>
          <div class="info-card-text">
            {{ block.settings.content | newline_to_br }}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Info Grid Custom",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Les détails"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Infos pratiques"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fbf8f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Subtitle)",
      "default": "#e4032b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "info_item",
      "name": "Info Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji Icon",
          "default": "📅"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card Heading",
          "default": "Dates"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Card Content",
          "default": "Line 1\nLine 2\nLine 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Info Grid Custom",
      "blocks": [
        { "type": "info_item" },
        { "type": "info_item" },
        { "type": "info_item" }
      ]
    }
  ]
}
{% endschema %}