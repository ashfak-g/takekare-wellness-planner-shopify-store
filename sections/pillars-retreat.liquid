{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .pillar-container-{{ section.id }} {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .pillar-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .pillar-subtitle-{{ section.id }} {
    font-family: Caveat, cursive;
    color: {{ section.settings.accent_color }};
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .pillar-title-{{ section.id }} {
    font-family: Instrument Serif, Georgia, serif;
    font-size: clamp(28px, 3.5vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .pillar-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media screen and (max-width: 767px) {
    .pillar-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
    .pillar-subtitle-{{ section.id }} {
      font-size: 18px;
      margin-bottom: 10px;
    }
    .pillar-header-{{ section.id }} {
      text-align: center;
      margin-bottom: 28px !important;
    }
    .pillar-title-{{ section.id }} {
      font-size: 26px;
      margin-bottom: 28px !important;
    }
    .pillar-card-{{ section.id }} {
      padding: 28px 20px !important;
    }
  }

  .pillar-card-{{ section.id }} {
    background: {{ section.settings.card_bg }};
    border-radius: 16px;
    padding: 40px 32px;
    border: 1px solid transparent;
    transition: 0.3s;
  }

  .pillar-card-{{ section.id }}:hover {
    background: rgb(255, 255, 255);
    border: 1px solid rgb(228, 3, 43);
    transform: translateY(-4px);
    box-shadow: rgba(228, 3, 43, 0.08) 0px 12px 40px;
  }

  .pillar-card-{{ section.id }}:hover .pillar-number-{{ section.id }} {
    color: rgb(228, 3, 43);
  }

  .pillar-number-{{ section.id }} {
    font-family: Instrument Serif, Georgia, serif;
    font-size: 60px;
    color: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
    line-height: 1;
    margin-bottom: 16px;
    font-style: italic;
    transition: color 0.3s;
  }

  .pillar-card-title-{{ section.id }} {
    font-family: Instrument Serif, Georgia, serif;
    font-size: 26px;
    font-weight: 400;
    color: {{ section.settings.text_color }};
    margin-bottom: 14px;
    line-height: 1.2;
  }

  .pillar-card-text-{{ section.id }} {
    font-family: "DM Sans", -apple-system, sans-serif;
    font-size: 15px;
    line-height: 1.75;
    color: #5C564F;
    margin: 0;
  }
{%- endstyle -%}

<section class="section-{{ section.id }}">
  <div class="pillar-container-{{ section.id }}">
    
    <div class="pillar-header-{{ section.id }}" data-aos="fade-up">
      {% if section.settings.subtitle != blank %}
        <div class="pillar-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</div>
      {% endif %}
      <h2 class="pillar-title-{{ section.id }}">{{ section.settings.title }}</h2>
    </div>

    <div class="pillar-grid-{{ section.id }}">
      {% for block in section.blocks %}
        {%- comment -%} Fixed: moved shopify_attributes inside the opening div tag {%- endcomment -%}
        <div class="pillar-card-{{ section.id }}" data-aos="fade-up" {{ block.shopify_attributes }}>
          <div class="pillar-number-{{ section.id }}">{{ block.settings.number }}</div>
          <h3 class="pillar-card-title-{{ section.id }}">{{ block.settings.heading }}</h3>
          <p class="pillar-card-text-{{ section.id }}">{{ block.settings.content }}</p>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Pillars Retreat",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FBF8F4"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Numbers/Subtitle)",
      "default": "#E4032B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Text Color",
      "default": "#0A0A0A"
    },
    {
      "type": "header",
      "content": "Header Text"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "La proposition de valeur"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Les 3 piliers de la retraite"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 140
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Block",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number (01, 02...)",
          "default": "01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Se recentrer"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Description",
          "default": "Deux jours hors du quotidien pour faire le point sur ce qui compte vraiment."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pillars Retreat",
      "blocks": [
        { "type": "pillar", "settings": { "number": "01", "heading": "Se recentrer" } },
        { "type": "pillar", "settings": { "number": "02", "heading": "Structurer" } },
        { "type": "pillar", "settings": { "number": "03", "heading": "S'ancrer" } }
      ]
    }
  ]
}
{% endschema %}