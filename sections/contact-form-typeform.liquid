{%- style -%}
  .typeform-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .typeform-container-{{ section.id }} {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .typeform-wrapper-{{ section.id }} {
    width: 100%;
    min-height: 500px;
    border-radius: 12px;
    overflow: hidden;
  }

  .typeform-wrapper-{{ section.id }} iframe {
    width: 100%;
    height: 500px;
    border: none;
  }
{%- endstyle -%}

<section class="typeform-section-{{ section.id }}">
  <div class="typeform-container-{{ section.id }}">
    <div class="typeform-wrapper-{{ section.id }}">
      {%- if section.settings.typeform_url != blank -%}
        <iframe 
          src="{{ section.settings.typeform_url }}" 
          title="Contact Form"
          allow="microphone; camera"
        ></iframe>
      {%- else -%}
        <div style="text-align: center; padding: 50px; border: 1px dashed #ccc;">
          please insert link
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Typeform Contact",
  "settings": [
    {
      "type": "text",
      "id": "typeform_url",
      "label": "Typeform Embed URL",
      "info": "Please insert link here",
      "default": "https://form.typeform.com/to/N57KODvo"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 860
    },
    {
      "type": "range",
      "id": "form_height",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Form Height",
      "default": 600
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Typeform Contact Form"
    }
  ]
}
{% endschema %}