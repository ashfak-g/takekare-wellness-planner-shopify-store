{%- style -%}
  :root {
    --font-display-val: 'Instrument Serif', Georgia, serif;
    --font-accent-val: 'Caveat', cursive;
    --font-sans-val: 'DM Sans', -apple-system, sans-serif;
    --primary-red: #E4032B;
    --text-dark: #0A0A0A;
    --text-muted: #5C564F;
    --bg-sand: #FBF8F4;
  }

  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--bg-sand);
    position: relative;
    overflow: hidden;
    font-family: var(--font-sans-val);
    display: block;
  }

  /* Dot Grid Background */
  .hero-dots-overlay {
    position: absolute;
    inset: 0px;
    background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23000' fill-opacity='0.015'%3E%3Ccircle cx='1' cy='1' r='1'/%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }

  .hero-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  /* Typography */
  .hero-badge {
    font-family: var(--font-accent-val);
    color: var(--primary-red);
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .hero-title {
    font-family: var(--font-display-val);
    font-size: clamp(38px, 4.8vw, 62px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-dark);
    margin-bottom: 28px;
    margin-top: 0;
  }

  .hero-title em {
    font-style: italic;
    color: var(--primary-red);
    text-decoration: underline 3px rgba(228, 3, 43, 0.25);
    text-underline-offset: 6px;
  }
  .hero-title em:hover{
    color: rgb(246, 186, 203) !important;
  }

  .hero-description {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 40px;
    max-width: 480px;
  }

  /* Button */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--primary-red);
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: 0.25s ease-in-out;
  }

  .hero-btn:hover {
    background: rgb(200, 2, 31);
    transform: translateY(-2px);
    filter: brightness(1.1);
    box-shadow: rgba(228, 3, 43, 0.3) 0px 8px 28px;
  }

  /* Image Area */
  .hero-image-wrapper {
    position: relative;
    max-width: 450px;
    margin: 0 auto;
  }

  .hero-image-bg-card {
    position: absolute;
    top: 20px;
    right: -16px;
    width: 100%;
    height: 100%;
    background: var(--primary-red);
    border-radius: 16px;
    z-index: 0;
    opacity: 0.12;
  }

  .hero-main-img-container {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    position: relative;
    z-index: 1;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  .hero-main-img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    filter: grayscale(0%);
  }

  .hero-main-img-container img:hover {
    filter: grayscale(100%);
  }

  /* Floating Elements (desktop only) */
  .stat-badge {
    position: absolute;
    top: 24px;
    right: -20px;
    z-index: 10;
    background: #0A0A0A;
    color: #fff;
    border-radius: 8px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    animation: none;
  }

  .quote-badge {
    position: absolute;
    bottom: 40px;
    left: -32px;
    z-index: 10;
    background: #fff;
    border-radius: 4px;
    padding: 20px 24px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    max-width: 240px;
    border-left: 3px solid var(--primary-red);
    animation: none;
  }
.anim-slide-up {
  opacity: 0;
  animation: slideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim-fade-scale {
  opacity: 0;
  animation: fadeScale 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeScale {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* EXACT SAME delay */
.delay-1 { animation-delay: 0.15s; }
.delay-2 { animation-delay: 0.3s; }
.delay-3 { animation-delay: 0.45s; }
.delay-4 { animation-delay: 0.6s; }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }



  /* Mobile quote block (hidden on desktop) */
  .mobile-quote-block {
    display: none;
  }

  /* ========== MOBILE STYLES (max-width: 768px) ========== */
  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: left;
    }

    .hero-content {
      margin: 0;
    }

    /* Smaller font sizes on mobile */
    .hero-badge {
      font-size: 20px;
      margin-bottom: 6px;
    }

    .hero-title {
      font-size: clamp(28px, 6vw, 40px);
      margin-bottom: 16px;
    }

    .hero-description {
      font-size: 14px;
      margin-bottom: 24px;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .hero-btn {
      padding: 12px 24px;
      font-size: 13px;
      width: auto;
    }

    .hero-buttons {
      justify-content: flex-start;
      display: flex;
    }

    /* Remove red background card behind image on mobile */
    .hero-image-bg-card {
      display: none;
    }

    /* Reduce image height on mobile (change aspect-ratio to 4/3, less tall) */
    .hero-main-img-container {
      aspect-ratio: 4 / 3;
    }

    /* Hide floating badges on mobile */
    .stat-badge,
    .quote-badge {
      display: none;
    }

    /* Show mobile quote block below image */
    .mobile-quote-block {
      display: block;
      margin-top: 32px;
      width: 100%;
      background: #ffffff;
      border-radius: 12px;
      padding: 20px 24px;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.06);
      border-left: 4px solid var(--primary-red);
    }

    .mobile-quote-text {
      font-family: var(--font-accent-val);
      font-size: 18px;
      color: var(--primary-red);
      line-height: 1.35;
      font-weight: 500;
    }

    .mobile-quote-author {
      font-size: 12px;
      color: #8A8178;
      margin-top: 8px;
      font-weight: 500;
      letter-spacing: 0.3px;
    }
  }

  @media (max-width: 768px) {
    .hero-badge{
      font-size: 19px;
    }
    .hero-title{
      font-size: 34px;
    }
  }

  /* Extra small devices (max-width: 480px) – further adjustments */
  @media (max-width: 480px) {
    .hero-btn {
      width: 100%;
      justify-content: center;
    }
    .mobile-quote-block {
      padding: 16px;
    }
    .mobile-quote-text {
      font-size: 16px;
    }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}">
  <div class="hero-dots-overlay"></div>

  <div class="hero-container">
    <div class="hero-grid">

      <div class="hero-content">
        {% if section.settings.sub_heading != blank %}
          <div class="hero-badge anim-slide-up delay-1">
            {{ section.settings.sub_heading }}
          </div>
        {% endif %}

        <h1 class="hero-title anim-slide-up delay-2">
          {{ section.settings.title }}
        </h1>

        <div class="hero-description anim-slide-up delay-3">
          {{ section.settings.description }}
        </div>

        <div class="hero-buttons anim-slide-up delay-4">
          <a href="{{ section.settings.btn_link }}" class="hero-btn">
            {{ section.settings.btn_text }}
            <svg width="16" height="16" fill="none" style="margin-left:8px;"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </div>

      <div class="hero-image-wrapper anim-fade-scale delay-2">
        <div class="hero-image-bg-card"></div>
        <div class="hero-main-img-container">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt }}" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>

        <!-- Desktop floating badges -->
        <div class="stat-badge">
          <div style="font-family: var(--font-display-val); font-size: 24px; line-height: 1;">{{ section.settings.stat_number }}</div>
          <div style="font-size: 11px; color: rgba(255, 255, 255, 0.6); line-height: 1.3; max-width: 80px;">{{ section.settings.stat_text }}</div>
        </div>

        <div class="quote-badge">
          <div style="font-family: var(--font-accent-val); font-size: 20px; color: var(--primary-red); line-height: 1.3;">
            "{{ section.settings.quote_text }}"
          </div>
          <div style="font-size: 12px; color: #8A8178; margin-top: 6px; font-weight: 500; letter-spacing: 0.3px;">
            — {{ section.settings.quote_author }}
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile quote block (appears below image, full width) -->
    <div class="mobile-quote-block">
      <div class="mobile-quote-text">
        “{{ section.settings.quote_text }}”
      </div>
      <div class="mobile-quote-author">
        — {{ section.settings.quote_author }} · {{ section.settings.stat_number }} {{ section.settings.stat_text }}
      </div>
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Hero Structured Method",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 116
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "Fondatrice de la Méthode Structurée"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "info": "Use <br> for new line and <em>Text</em> for red underline",
      "default": "Je suis Léa,<br>et j'aide les femmes à reprendre le <em>contrôle de leur quotidien.</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>J’ai créé la Méthode Structurée pour les femmes qui portent trop de choses à la fois : travail, projets, vie personnelle… Et qui ont l’impression de courir en permanence, sans jamais vraiment avoir le temps pour ce qui compte vraiment.</p>"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Découvrir la Méthode"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat Number",
      "default": "+500"
    },
    {
      "type": "text",
      "id": "stat_text",
      "label": "Stat Text",
      "default": "femmes accompagnées"
    },
    {
      "type": "text",
      "id": "quote_text",
      "label": "Quote",
      "default": "Tu n'es pas mal organisée, tu manques d'un système pensé pour toi !"
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Author",
      "default": "Léa Coffrant"
    }
  ],
  "presets": [
    {
      "name": "Hero Structured Method"
    }
  ]
}
{% endschema %}