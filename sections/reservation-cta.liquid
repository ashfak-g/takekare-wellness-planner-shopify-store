{%- style -%}
  .cta-section-{{ section.id }} {
    padding: clamp(32px, 8vw, 55px) 0; /* Légèrement augmenté pour plus d'air sur desktop */
    background-color: {{ section.settings.bg_color }};
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta-bg-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 0;
  }

  .cta-content-{{ section.id }} {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-badge-{{ section.id }} {
    font-family: Caveat, cursive;
    color: {{ section.settings.accent_color }};
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .cta-title-{{ section.id }} {
    font-family: Instrument Serif, Georgia, serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 400;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 14px;
  }

  .cta-title-{{ section.id }} em {
    font-style: italic;
    color: {{ section.settings.accent_color }};
  }

  .cta-description-{{ section.id }} {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.7;
    max-width: 500px;
    margin: 0 auto 40px;
  }

  .cta-button-container-{{ section.id }} {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .cta-button-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: {{ section.settings.accent_color }};
    color: #ffffff;
    padding: 16px 40px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 700;
    transition: 0.25s ease;
    text-decoration: none;
  }

  .cta-button-{{ section.id }}:hover {
    filter: brightness(1.1);
    transform: translateY(-2px);
  }

  .cta-footer-text-{{ section.id }} {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.3);
  }
{%- endstyle -%}

<section class="cta-section-{{ section.id }}" id="reservation-{{ section.id }}">
  <div class="cta-bg-overlay-{{ section.id }}" 
       style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% endif %}">
  </div>

 <div class="cta-content-{{ section.id }}"
 data-aos="fade-up"
 data-aos-duration="900"
 data-aos-easing="ease-out-cubic">
    {% if section.settings.badge != blank %}
      <div class="cta-badge-{{ section.id }}" data-aos="fade-up" data-aos-delay="50">{{ section.settings.badge }}</div>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 class="cta-title-{{ section.id }}" data-aos="fade-up" data-aos-delay="100">
        {{ section.settings.title | replace: '[', '<em>' | replace: ']', '</em>' }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="cta-description-{{ section.id }}" data-aos="fade-up" data-aos-delay="150">{{ section.settings.description }}</p>
    {% endif %}

    <div class="cta-button-container-{{ section.id }}">
      <a href="{{ section.settings.button_link }}" class="cta-button-{{ section.id }}" data-aos="fade-up" data-aos-delay="200">
        {{ section.settings.button_text }}
        <svg width="16" height="16" fill="none" viewBox="0 0 16 16">
          <path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    {% if section.settings.footer_text != blank %}
      <p class="cta-footer-text-{{ section.id }}" data-aos="fade-up" data-aos-delay="250">{{ section.settings.footer_text }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Reservation CTA",
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Reservation"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "info": "Use brackets [ ] to make text italic and red. Example: 12 spots. [Yours?]",
      "default": "12 spots. [Yours?]"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Previous editions were all sold out weeks in advance. If this retreat speaks to you, it's now."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Book my spot"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Small Text",
      "default": "Installment payments available · Limited spots"
    },
    {
      "type": "header",
      "content": "Style & Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Texture/Image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background Opacity",
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1c1610"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Red)",
      "default": "#e4032b"
    }
  ],
  "presets": [
    {
      "name": "Reservation CTA"
    }
  ]
}
{% endschema %}