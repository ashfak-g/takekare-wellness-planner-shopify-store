{
  "type": "footer",
  "name": "Footer",
  "sections": {
    "footer": {
      "type": "footer",
      "settings": {
        "footer_bg": "#fbf8f4",
        "logo": "shopify:\/\/shop_images\/logo.png",
        "footer_menu": "custom-footer",
        "insta_link": "https:\/\/instagram.com\/takekare.co",
        "linkedin_link": "https:\/\/www.linkedin.com\/in\/l%C3%A9a-coffrant-675396a3\/",
        "copyright_text": "© 2026 Take Kare — Tous droits réservés"
      }
    },
    "mobile-sticky-bar": {
      "type": "mobile-sticky-bar",
      "settings": {
        "show_mobile_sticky": false,
        "show_home_icon": true,
        "show_collection_icon": true,
        "show_cart_icon": true,
        "show_search_icon": true,
        "show_account_icon": false,
        "show_wishlist_icon": false
      }
    },
    "age-verifier-popup": {
      "type": "age-verifier-popup",
      "blocks": {
        "block-1": {
          "type": "heading",
          "settings": {
            "heading": "Confirm your age"
          }
        },
        "block-2": {
          "type": "text",
          "settings": {
            "text": "<p>Are you 18 years old or older?<\/p>"
          }
        },
        "block-3": {
          "type": "buttons",
          "settings": {
            "decline_button": "No, I'm not",
            "approve_button": "Yes, I am"
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3"
      ],
      "settings": {
        "design_mode": false,
        "enable": false,
        "bg_blur": true,
        "decline_heading": "Come back when you're older",
        "decline_content": "<p>Sorry, the content of this store can't be seen by a younger audience. Come back when you're older.<\/p>",
        "return_button": "Oops, I entered incorrectly"
      }
    }
  },
  "order": [
    "footer",
    "mobile-sticky-bar",
    "age-verifier-popup"
  ]
}
