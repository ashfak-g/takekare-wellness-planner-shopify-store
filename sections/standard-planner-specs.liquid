{%- style -%}
  :root {
    --font-accent-val: 'Caveat', cursive;
    --font-display-val: 'Instrument Serif', Georgia, serif;
    --font-sans-val: 'DM Sans', -apple-system, sans-serif;
    --color-primary-red: #e4032b;
  }

  .specs-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    font-family: var(--font-sans-val);
    -webkit-font-smoothing: antialiased;
    color: #0a0a0a;
  }

  .specs-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .specs-flex {
    display: flex;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  @media (max-width: 767px) {
    .specs-flex {
      flex-direction: column;
    }
  }

  .specs-image-side {
    flex: 0 0 auto;
    width: min(400px, 100%);
  }

  .specs-image-wrapper {
    background: #f3ede5;
    border-radius: 16px;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .specs-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .specs-content-side {
    flex: 1 1 0%;
  }

  .specs-subheading {
    font-family: var(--font-accent-val);
    color: var(--color-primary-red);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .specs-title {
    font-family: var(--font-display-val);
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 400;
    color: #0a0a0a;
    margin-bottom: 28px;
    line-height: 1.2;
  }

  .specs-title em {
    font-style: italic;
    color: var(--color-primary-red);
  }

  .specs-list {
    display: flex;
    flex-direction: column;
    gap: 0px;
  }

  .specs-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
  }

  .specs-label {
    font-size: 14px;
    color: #8a8178;
    font-weight: 500;
  }

  .specs-value {
    font-size: 14px;
    color: #0a0a0a;
    font-weight: 700;
    text-align: right;
  }
{%- endstyle -%}

<section class="specs-section-{{ section.id }}">
  <div class="specs-container">
    <div class="specs-flex">
      
      <div class="specs-image-side">
        <div class="specs-image-wrapper">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 800 | image_tag: alt: section.settings.title, loading: 'lazy' }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>

      <div class="specs-content-side">
        {% if section.settings.subheading != blank %}
          <div class="specs-subheading">{{ section.settings.subheading }}</div>
        {% endif %}

        <h2 class="specs-title">
          {{ section.settings.title }}
        </h2>

        <div class="specs-list">
          {% for block in section.blocks %}
            <div class="specs-row" {{ block.shopify_attributes }}>
              <span class="specs-label">{{ block.settings.label }}</span>
              <span class="specs-value">{{ block.settings.value }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Standard Planner Specs",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Detail Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fait avec soin"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Un objet pensé pour <em>durer</em>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "spec_item",
      "name": "Specification Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (Left)",
          "default": "Format"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value (Right)",
          "default": "A5 (148 × 210 mm)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standard Planner Specs",
      "blocks": [
        { "type": "spec_item", "settings": { "label": "Format", "value": "A5 (148 × 210 mm)" } },
        { "type": "spec_item", "settings": { "label": "Pages", "value": "220 pages" } },
        { "type": "spec_item", "settings": { "label": "Couverture", "value": "Rigide toilée, ivoire" } },
        { "type": "spec_item", "settings": { "label": "Papier", "value": "80g, crème" } }
      ]
    }
  ]
}
{% endschema %}