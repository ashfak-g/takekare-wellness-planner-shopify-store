{%- style -%}
:root {
  --font-sans-val: 'DM Sans', -apple-system, sans-serif;
  --font-display-val: 'Instrument Serif', Georgia, serif;
  --font-accent-val: 'Caveat', cursive;
  --primary-red: #e4032b;
  --text-dark: #0a0a0a;
  --text-muted: #5c564f;
}

.hero-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background: {{ section.settings.bg_color }};
  position: relative;
  overflow: hidden;
  font-family: var(--font-sans-val);
}

.hero-bg-pattern {
  position: absolute;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23000' fill-opacity='0.015'%3E%3Ccircle cx='1' cy='1' r='1'/%3E%3C/g%3E%3C/svg%3E");
  pointer-events: none;
}

.hero-container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
  z-index: 1;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

@media (max-width: 990px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }
}

.hero-content {
  max-width: 560px;
}

.hero-subtitle {
  font-family: var(--font-accent-val);
  color: var(--primary-red);
  font-size: 28px;
  font-weight: 600;
  margin-bottom: 10px;
}

.hero-title {
  font-family: var(--font-display-val);
  font-size: clamp(38px, 4.8vw, 62px);
  font-weight: 400;
  line-height: 1.1;
  color: var(--text-dark);
  margin-bottom: 28px;
}

.hero-title em {
  font-style: italic;
  color: var(--primary-red);
  text-decoration: underline 3px rgba(228, 3, 43, 0.25);
  text-underline-offset: 6px;
  transition: color 0.2s;
}

.hero-title em:hover {
  font-style: italic;
  color: rgb(246, 186, 203);
  text-decoration: underline 3px rgba(228, 3, 43, 0.25);
  text-underline-offset: 6px;
  transition: color 0.2s;
}

.hero-description {
  font-size: 16px;
  line-height: 1.75;
  color: var(--text-muted);
  margin-bottom: 40px;
  max-width: 480px;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: rgb(200, 2, 31);
  color: rgb(255, 255, 255);
  padding: 16px 36px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.5px;
  transition: 0.25s;
  width: auto;
}

.hero-btn:hover {
  transform: translateY(-2px);
  box-shadow: rgba(228, 3, 43, 0.3) 0px 8px 28px;
}

.hero-image-wrapper {
  position: relative;
}

.hero-img-bg-box {
  position: absolute;
  top: 20px;
  right: -16px;
  width: 100%;
  height: 100%;
  background: var(--primary-red);
  border-radius: 16px;
  z-index: 0;
  opacity: 0.12;
}

.hero-img-container {
  border-radius: 16px;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  position: relative;
  z-index: 1;
  background: #eee;
}

.hero-img-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

/* Floating Stats Badge */
.badge-stats {
  position: absolute;
  top: 24px;
  right: -20px;
  z-index: 10;
  background: #0a0a0a;
  color: #ffffff;
  border-radius: 8px;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.badge-stats-num {
  font-family: var(--font-display-val);
  font-size: 24px;
  line-height: 1;
}

.badge-stats-text {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.3;
  max-width: 80px;
}

/* Floating Quote Badge */
.badge-quote {
  position: absolute;
  bottom: 40px;
  left: -32px;
  z-index: 10;
  background: #ffffff;
  border-radius: 4px;
  padding: 20px 24px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
  max-width: 240px;
  border-left: 3px solid var(--primary-red);
}

.badge-quote-text {
  font-family: var(--font-accent-val);
  font-size: 20px;
  color: var(--primary-red);
  line-height: 1.3;
}

.badge-quote-author {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 6px;
  font-weight: 500;
  letter-spacing: 0.3px;
}

@media (max-width: 767px) {
  .badge-quote {
    left: 0;
    bottom: 20px;
    max-width: 200px;
  }
  .badge-stats {
    right: 0;
  }
}
{%- endstyle -%}

<section class="hero-{{ section.id }}">
  <div class="hero-bg-pattern"></div>
  <div class="hero-container">
    <div class="hero-grid">

      <div class="hero-content">
        <div class="hero-subtitle"
             data-aos="fade-up"
             data-aos-easing="linear"
             data-aos-duration="1200">
          {{ section.settings.subtitle }}
        </div>

        <h1 class="hero-title"
            data-aos="fade-up"
            data-aos-easing="linear"
            data-aos-duration="1200"
            data-aos-delay="200">
          {{ section.settings.title }}
        </h1>

        <div class="hero-description"
             data-aos="fade-up"
             data-aos-easing="linear"
             data-aos-duration="1200"
             data-aos-delay="400">
          {{ section.settings.description }}
        </div>

        {% if section.settings.btn_label != blank %}
          <a href="{{ section.settings.btn_link }}"
             class="hero-btn"
             data-aos="fade-up"
             data-aos-easing="linear"
             data-aos-duration="1200"
             data-aos-delay="400">
            {{ section.settings.btn_label }}
            <svg width="16" height="16" fill="none" viewBox="0 0 16 16">
              <path d="M3 8h10m0 0L9 4m4 4L9 12"
                    stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        {% endif %}
      </div>

      <div class="hero-image-wrapper">
        <div class="hero-img-bg-box"></div>
        <div class="hero-img-container">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 800 | image_tag: alt: section.settings.image.alt, loading: 'lazy' }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>

        <div class="badge-stats">
          <div class="badge-stats-num">{{ section.settings.stats_num }}</div>
          <div class="badge-stats-text">{{ section.settings.stats_text }}</div>
        </div>

        <div class="badge-quote">
          <div class="badge-quote-text">{{ section.settings.quote_text }}</div>
          <div class="badge-quote-author">{{ section.settings.quote_author }}</div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Profile",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#fbf8f4" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Fondatrice de la Méthode Structurée" },
    { "type": "textarea", "id": "title", "label": "Title (Use <em> for red underline)", "default": "Je suis Léa,<br>et j'aide les femmes à reprendre le <em>contrôle de leur quotidien.</em>" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "J’ai créé la Méthode Structurée pour les femmes qui portent trop de choses à la fois..." },
    { "type": "text", "id": "btn_label", "label": "Button Label", "default": "Découvrir la Méthode" },
    { "type": "url", "id": "btn_link", "label": "Button Link" },
    { "type": "image_picker", "id": "image", "label": "Profile Image" },
    { "type": "header", "content": "Floating Badges" },
    { "type": "text", "id": "stats_num", "label": "Stats Number", "default": "+500" },
    { "type": "text", "id": "stats_text", "label": "Stats Text", "default": "femmes accompagnées" },
    { "type": "textarea", "id": "quote_text", "label": "Floating Quote", "default": "\"Tu n'es pas mal organisée, tu manques d'un système pensé pour toi !\"" },
    { "type": "text", "id": "quote_author", "label": "Quote Author", "default": "— Léa Coff" },
    { "type": "header", "content": "Section Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Padding Top", "default": 116 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Padding Bottom", "default": 140 }
  ],
  "presets": [{ "name": "Hero Home Profile" }]
}
{% endschema %}